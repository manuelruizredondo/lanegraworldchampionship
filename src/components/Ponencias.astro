---
// Los tres carteles del ciclo de ponencias.
//
// El día, la hora y la sala se leen del programa buscando por el texto
// español exacto de cada sesión: así, si se mueve una charla, esta página
// se entera sola y no hay dos sitios que puedan contradecirse.
import { PONENCIAS, I18N } from "@/data/ponencias.js";
import { PROGRAMA, ROOMS, I18N as PROG_I18N } from "@/data/programa.js";
import { img } from "@/data/img.js";
import { biosDe } from "@/data/artist-bios.js";

const { lang = "es" } = Astro.props;
const t = I18N[lang] || I18N.es;
const tp = PROG_I18N[lang] || PROG_I18N.es;
const PROGRAMA_HREF = { es: "/programacion-2026/", en: "/en/programme-2026/", it: "/it/programma-2026/" }[lang] || "/programacion-2026/";

// Busca una sesión del programa por su nombre español.
function cuando(clave) {
  for (const d of PROGRAMA) {
    for (const s of d.sessions) {
      if (s.n === clave) {
        const dia = (tp.days && tp.days[d.day]) || d.day;
        return {
          dia, fecha: d.date, hora: s.t, sala: ROOMS[s.r] || s.r,
          // Misma clave que compone el corazón de la programación
          // (`díaÍndice|franja|sala|nombre`): así una charla marcada aquí
          // aparece marcada allí, y al revés, sin duplicar nada.
          fav: `${PROGRAMA.indexOf(d)}|${s.t}|${s.r}|${s.n}`,
        };
      }
    }
  }
  return null;
}

// Si la ponencia no trae bio propia se usa la de la ficha de artista.
const BIOS = biosDe(lang);
const fichas = PONENCIAS.map((p) => ({
  ...p,
  horario: cuando(p.clave),
  textoBio: (p.bio && (p.bio[lang] || p.bio.es)) || BIOS[p.ponente] || null,
}));
const iniciales = (n) => n.split(" ").filter(Boolean).slice(0, 2).map((x) => x[0]).join("");
---

<div class="prop">
  <section class="p-section po">
    <div class="p-container">
      <p class="p-eyebrow">{t.eyebrow}</p>
      <h1 class="p-display po-h1">{t.h1}</h1>
      <p class="p-lead p-narrow">{t.lead}</p>

      <div class="po-rejilla">
        {fichas.map((p) => (
          <article class="po-cartel">
            <div class="po-foto">
              {p.img
                ? <img src={img(p.img)} alt={p.ponente} loading="lazy" decoding="async" />
                : <span class="po-iniciales" aria-hidden="true">{iniciales(p.ponente)}</span>}
            </div>

            <div class="po-texto">
              <p class="po-cuando">
                {p.horario
                  ? `${p.horario.dia} ${p.horario.fecha} · ${p.horario.hora} · ${p.horario.sala}`
                  : t.sinHorario}
              </p>
              <div class="po-cab">
                <h2 class="po-titulo">{p.titulo[lang] || p.titulo.es}</h2>
                {p.horario && (
                  <button class="po-fav" type="button" aria-pressed="false"
                          aria-label={t.favAria} title={t.favAria} data-fav={p.horario.fav}>
                    <svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                  </button>
                )}
              </div>
              <p class="po-bajada">{p.bajada[lang] || p.bajada.es}</p>
              <p class="po-ponente">{p.ponente}</p>
              {p.credencial && <p class="po-credencial">{p.credencial[lang] || p.credencial.es}</p>}

              {p.textoBio && (
                <details class="po-bio">
                  <summary>{t.verBio}</summary>
                  <p>{p.textoBio}</p>
                </details>
              )}

              {(p.ig || p.web) && (
                <p class="po-enlace">
                  <a href={p.ig || p.web} target="_blank" rel="noopener">
                    {p.ig ? "Instagram ↗" : "Web ↗"}
                  </a>
                </p>
              )}
            </div>
          </article>
        ))}
      </div>

      <p class="po-pie">
        <a class="p-btn p-btn-dark" href={PROGRAMA_HREF}>{t.enPrograma}</a>
      </p>
    </div>
  </section>
</div>

<script is:inline define:vars={{ IDIOMA: lang }}>
  // Favoritos del ciclo. Usan la MISMA clave y el MISMO almacén que el corazón
  // de la programación, así que marcar aquí se ve allí y al revés.
  (function () {
    const BOTONES = Array.prototype.slice.call(document.querySelectorAll(".po-fav"));
    if (!BOTONES.length) return;
    const CLAVE = "lanegra:programa:favs";
    const leer = () => { try { return new Set(JSON.parse(localStorage.getItem(CLAVE) || "[]")); } catch (e) { return new Set(); } };
    const guardar = (f) => { try { localStorage.setItem(CLAVE, JSON.stringify([].concat(Array.from(f)))); } catch (e) {} };

    let favs = leer();
    const pintar = () => BOTONES.forEach(function (b) {
      const on = favs.has(b.dataset.fav);
      b.classList.toggle("es-fav", on);
      b.setAttribute("aria-pressed", on ? "true" : "false");
    });
    pintar();

    // Si hay sesión, el cambio sube también a la cuenta. Si no la hay, o si
    // falla, queda guardado en este navegador: la programación lo subirá la
    // próxima vez que se abra con la sesión iniciada.
    async function aLaCuenta(clave, anadir) {
      try {
        const cuenta = window.laNegraCuenta;
        const sesion = cuenta && cuenta.sesion && cuenta.sesion();
        if (!sesion) return;
        const sb = await cuenta.cliente();
        const uid = sesion.user.id;
        if (anadir) {
          const p = clave.split("|");
          const dia = Number.parseInt(p[0], 10);
          await sb.from("favoritos").insert([{
            user_id: uid, email: sesion.user.email, clave: clave,
            dia: Number.isInteger(dia) ? dia : null,
            sala: p[2] || null, titulo: p.slice(3).join("|") || null, idioma: IDIOMA,
          }]);
        } else {
          await sb.from("favoritos").delete().eq("user_id", uid).eq("clave", clave);
        }
      } catch (e) { /* el favorito ya está guardado en el navegador */ }
    }

    BOTONES.forEach(function (b) {
      b.addEventListener("click", function () {
        const k = b.dataset.fav;
        favs = leer();                       // por si otra pestaña lo cambió
        const anadir = !favs.has(k);
        if (anadir) favs.add(k); else favs.delete(k);
        guardar(favs);
        pintar();
        b.classList.remove("po-fav-pop"); void b.offsetWidth;
        if (anadir) b.classList.add("po-fav-pop");
        aLaCuenta(k, anadir);
      });
    });

    // Al volver de iniciar sesión, o desde otra pestaña, se repinta.
    window.addEventListener("focus", function () { favs = leer(); pintar(); });
  })();
</script>

<style>
  .po { padding-top: 20px; }

  /* El corazón vive a la derecha del titular, alineado con su primera línea. */
  .po-cab { display: flex; align-items: flex-start; gap: 12px; }
  .po-cab .po-titulo { flex: 1 1 auto; min-width: 0; }
  .po-fav {
    flex: 0 0 auto; margin-top: 2px; background: none; border: 0; padding: 2px;
    cursor: pointer; color: #d7d2c8; line-height: 0; transition: color .18s ease;
  }
  .po-fav svg path { fill: currentColor; }
  .po-fav:hover { color: #ec7c90; }
  .po-fav.es-fav { color: #e0435f; }
  .po-fav.po-fav-pop svg { animation: poFavPop .34s ease; }
  @keyframes poFavPop {
    0% { transform: scale(1); } 40% { transform: scale(1.32); } 100% { transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) { .po-fav.po-fav-pop svg { animation: none; } }
  .po-h1 { font-size: clamp(34px, 5vw, 60px); margin-bottom: 16px; }

  .po-rejilla {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(270px, 1fr));
    gap: 22px; margin-top: 34px;
  }
  .po-cartel {
    display: flex; flex-direction: column; overflow: hidden;
    background: #fff; border: 1px solid #ece7dd; border-radius: 18px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, .05);
  }

  .po-foto {
    position: relative; aspect-ratio: 4 / 5; background: #f2ede4;
    display: flex; align-items: center; justify-content: center;
  }
  .po-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .po-iniciales {
    font-size: 54px; font-weight: 800; letter-spacing: -.03em;
    color: var(--gold-dark, #a2823f); opacity: .5;
  }
  .po-pendiente {
    position: absolute; bottom: 12px; left: 50%; transform: translateX(-50%);
    background: rgba(20, 18, 26, .72); color: #fff; border-radius: 999px;
    padding: 4px 12px; font-size: 11.5px; font-weight: 700; white-space: nowrap;
  }

  .po-texto { padding: 18px 20px 22px; display: flex; flex-direction: column; flex: 1; }
  .po-cuando {
    margin: 0 0 8px; font-size: 11.5px; font-weight: 800; letter-spacing: .06em;
    text-transform: uppercase; color: var(--gold-dark, #a2823f);
  }
  .po-titulo { margin: 0 0 8px; font-size: 21px; font-weight: 800; letter-spacing: -.01em; color: #14121a; line-height: 1.2; }
  .po-bajada { margin: 0 0 14px; font-size: 14.5px; line-height: 1.55; color: #4a4a54; flex: 1; }
  .po-ponente { margin: 0; font-size: 14.5px; font-weight: 700; color: #14121a; }
  .po-credencial { margin: 2px 0 0; font-size: 12.5px; line-height: 1.4; color: #8a8578; }
  .po-bio { margin-top: 10px; }
  .po-bio summary {
    cursor: pointer; font-size: 13px; font-weight: 700;
    color: var(--gold-dark, #a2823f); list-style: none;
  }
  .po-bio summary::-webkit-details-marker { display: none; }
  .po-bio summary::after { content: " ↓"; }
  .po-bio[open] summary::after { content: " ↑"; }
  .po-bio p { margin: 8px 0 0; font-size: 13.5px; line-height: 1.6; color: #4a4a54; }
  .po-enlace { margin: 4px 0 0; font-size: 13px; }
  .po-enlace a { color: var(--gold-dark, #a2823f); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .po-pie { margin: 34px 0 0; }
</style>
