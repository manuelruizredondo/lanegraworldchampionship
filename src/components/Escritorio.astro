---
// Escritorio de la cuenta: quién eres, cómo salir y, debajo, lo tuyo.
//
// Si la base dice que tienes rol de admin, se monta el panel de la
// organización. Si no, tus talleres favoritos. Lo decide la base, no la
// página: una cuenta sin permiso recibe listas vacías aunque trastee el HTML.
import PanelOrganizacion from "@/components/PanelOrganizacion.astro";
import { PANEL_I18N, CUENTA_I18N } from "@/data/supabase.js";
import { PROGRAMA, ROOMS } from "@/data/programa.js";

const { lang = "es" } = Astro.props;
const t = PANEL_I18N[lang] || PANEL_I18N.es;
const tc = CUENTA_I18N[lang] || CUENTA_I18N.es;
const DIAS = PROGRAMA.map((d) => d.short);
const PROGRAMA_HREF = { es: "/programacion-2026/", en: "/en/programme-2026/", it: "/it/programma-2026/" }[lang] || "/programacion-2026/";
---

<div class="prop">
  <section class="p-section esc">
    <div class="p-container">
      <p class="p-eyebrow">{t.eyebrow}</p>
      <h1 class="p-display esc-title">{t.titulo}</h1>

      <div class="esc-caja" data-fuera hidden>
        <p>{t.sinSesion}</p>
        <button type="button" class="p-btn p-btn-dark" data-cu-abrir>{tc.entrar}</button>
      </div>

      <p class="esc-cargando" data-cargando>{t.cargando}</p>

      <div data-dentro hidden>
        <div class="esc-id">
          <p class="esc-quien"><span>{t.sesionDe}</span> <strong data-email></strong></p>
          <button type="button" class="p-btn p-btn-light p-btn-sm" data-salir>{t.salir}</button>
        </div>

        {/* Editar los propios datos. El rol y el email no se tocan desde aquí:
            lo impide un disparador en la base, no solo esta pantalla. */}
        <details class="esc-editar">
          <summary>{tc.editarTitulo}</summary>
          <div class="esc-editar-cuerpo">
            <label class="esc-lbl" for="esc-nombre">{tc.campoNombre}</label>
            <input class="esc-input" id="esc-nombre" type="text" autocomplete="name" placeholder={tc.phNombre} />

            <div data-esc-pass hidden>
              <label class="esc-lbl" for="esc-pass">{tc.passNueva}</label>
              <input class="esc-input" id="esc-pass" type="password" autocomplete="new-password" minlength="8" />
            </div>
            <p class="esc-nota-pass" data-esc-nota-google hidden>{tc.soloGoogle}</p>

            <button type="button" class="p-btn p-btn-dark p-btn-sm" data-esc-guardar>{tc.guardar}</button>
            <p class="esc-msg" data-esc-msg hidden role="status"></p>
          </div>
        </details>

        <p class="esc-admin" data-aviso-admin hidden>{t.admin}</p>
        <PanelOrganizacion />

        <div data-favoritos hidden>
          <h2 class="esc-h2">{t.favTitulo}</h2>
          <p class="esc-lead">{t.favLead}</p>
          <div class="esc-tabla-wrap">
            <table class="esc-tabla">
              <thead><tr><th>#</th><th>{t.colSesion}</th><th>{t.colDia}</th><th>{t.colSala}</th><th></th></tr></thead>
              <tbody data-tbody-favs></tbody>
            </table>
          </div>
          <p class="esc-pie"><a class="p-btn p-btn-dark p-btn-sm" href={PROGRAMA_HREF}>{tc.anadirMas}</a></p>
        </div>
      </div>
    </div>
  </section>
</div>

<script is:inline define:vars={{ DIAS, ROOMS, T: { ...t, ...tc }, HOME: { es: "/", en: "/en/", it: "/it/" }[lang] || "/" }}>
  (function () {
    const $ = (s) => document.querySelector(s);

    async function pintar() {
      const sb = await window.laNegraCuenta.cliente();
      const sesion = window.laNegraCuenta.sesion();
      $("[data-cargando]").hidden = true;

      if (!sesion) {
        $("[data-fuera]").hidden = false;
        $("[data-dentro]").hidden = true;
        return;
      }
      $("[data-fuera]").hidden = true;
      $("[data-dentro]").hidden = false;
      $("[data-email]").textContent = sesion.user.email || "";

      // El rol lo dice la base.
      const { data: perfil } = await sb.from("perfiles").select("rol, nombre").eq("id", sesion.user.id).maybeSingle();
      const esAdmin = !!perfil && perfil.rol === "admin";

      $("[data-aviso-admin]").hidden = !esAdmin;
      $("[data-panel-org]").hidden = !esAdmin;
      $("[data-favoritos]").hidden = esAdmin;

      // Los datos editables
      const porGoogle = (sesion.user.app_metadata || {}).provider === "google";
      $("[data-esc-pass]").hidden = porGoogle;
      $("[data-esc-nota-google]").hidden = !porGoogle;
      const inNombre = $("#esc-nombre");
      if (perfil && !inNombre.value) inNombre.value = perfil.nombre || "";

      if (esAdmin) {
        await window.laNegraPanelOrg.pintar(sb);
      } else {
        // Lo mismo aquí: si entra directo al escritorio sin pasar por la
        // programación, también se le asignan los antiguos.
        try { await sb.rpc("reclamar_favoritos"); } catch (e) {}
        const { data } = await sb.from("favoritos").select("clave, titulo, dia, sala").order("dia");
        pintarFavoritos(data || []);
      }
    }

    function renumerarFavoritos() {
      const tb = $("[data-tbody-favs]");
      const filas = [...tb.querySelectorAll("tr[data-clave]")];
      filas.forEach((tr, i) => { tr.querySelector("td.pos").textContent = String(i + 1); });
      if (!filas.length) pintarFavoritos([]);
    }

    function pintarFavoritos(filas) {
      const tb = $("[data-tbody-favs]");
      tb.innerHTML = "";
      if (!filas.length) {
        const tr = document.createElement("tr");
        const td = document.createElement("td");
        td.colSpan = 5; td.className = "vacio"; td.textContent = T.favVacio;
        tr.appendChild(td); tb.appendChild(tr); return;
      }
      filas.forEach((x, i) => {
        const tr = document.createElement("tr");
        tr.dataset.clave = x.clave;
        [[i + 1, "pos"], [x.titulo || x.clave, "titulo"], [DIAS[x.dia] || "—", ""], [ROOMS[x.sala] || x.sala || "—", ""]]
          .forEach(([v, cls]) => {
            const td = document.createElement("td");
            td.textContent = String(v);
            if (cls) td.className = cls;
            tr.appendChild(td);
          });
        const tdB = document.createElement("td");
        tdB.className = "acciones";
        const b = document.createElement("button");
        b.type = "button"; b.className = "esc-quitar";
        b.textContent = T.quitar;
        b.setAttribute("aria-label", T.quitarAria + ": " + (x.titulo || x.clave));
        b.dataset.quitar = x.clave;
        tdB.appendChild(b); tr.appendChild(tdB);
        tb.appendChild(tr);
      });
    }

    const FAV_KEY = "lanegra:programa:favs";

    document.addEventListener("click", async (e) => {
      const quitar = e.target.closest("[data-quitar]");
      if (quitar) {
        const clave = quitar.dataset.quitar;
        quitar.disabled = true;
        try {
          const sb = await window.laNegraCuenta.cliente();
          const sesion = window.laNegraCuenta.sesion();
          const { error } = await sb.from("favoritos").delete()
            .eq("user_id", sesion.user.id).eq("clave", clave);
          if (error) throw error;
          // También del navegador: si no, al volver a la programación
          // reaparecería y se volvería a subir.
          try {
            const g = new Set(JSON.parse(localStorage.getItem(FAV_KEY) || "[]"));
            g.delete(clave);
            localStorage.setItem(FAV_KEY, JSON.stringify([...g]));
          } catch (err) {}
          const fila = quitar.closest("tr");
          fila.remove();
          renumerarFavoritos();
        } catch (err) {
          quitar.disabled = false;
        }
        return;
      }
      if (e.target.closest("[data-esc-guardar]")) {
        const boton = e.target.closest("[data-esc-guardar]");
        const msg = $("[data-esc-msg]");
        const nombre = ($("#esc-nombre").value || "").trim();
        const pass = ($("#esc-pass").value || "");
        const decir = (txt, err) => { msg.textContent = txt; msg.className = "esc-msg" + (err ? " err" : " ok"); msg.hidden = false; };
        if (nombre.length < 2) { decir(T.errNombre, true); return; }
        if (pass && pass.length < 8) { decir(T.errPassCorta, true); return; }

        const antes = boton.textContent;
        boton.disabled = true; boton.textContent = T.guardando;
        try {
          const sb = await window.laNegraCuenta.cliente();
          const sesion = window.laNegraCuenta.sesion();
          const { error } = await sb.from("perfiles").update({ nombre }).eq("id", sesion.user.id);
          if (error) throw error;
          // Se guarda también en la cuenta, para que no queden descuadrados.
          const extra = { data: { full_name: nombre } };
          if (pass) extra.password = pass;
          await sb.auth.updateUser(extra);
          decir(pass ? T.guardado + " " + T.passCambiada : T.guardado, false);
          $("#esc-pass").value = "";
        } catch (err) {
          decir((err && err.message) || T.errGenerico, true);
        }
        boton.disabled = false; boton.textContent = antes;
        return;
      }
      if (!e.target.closest("[data-salir]")) return;
      const sb = await window.laNegraCuenta.cliente();
      await sb.auth.signOut();
      window.location.href = HOME;
    });

    const esperar = setInterval(() => {
      if (!window.laNegraCuenta) return;
      clearInterval(esperar);
      window.laNegraCuenta.alCambiar(() => pintar());
      window.laNegraCuenta.cliente().then(pintar);
    }, 120);
  })();
</script>

<style>
  .esc { padding-top: 20px; }
  .esc-title { font-size: clamp(30px, 4.4vw, 52px); margin-bottom: 22px; }
  .esc-cargando { color: #8a8578; font-size: 14px; }
  .esc-caja { max-width: 460px; background: #fff; border: 1px solid #ece7dd; border-radius: 14px; padding: 22px; }
  .esc-caja p { margin: 0 0 14px; }
  .esc-caja[hidden], .esc-cargando[hidden] { display: none; }

  .esc-id {
    display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 12px;
    background: #fff; border: 1px solid #ece7dd; border-radius: 14px; padding: 16px 18px; margin-bottom: 20px;
  }
  .esc-quien { margin: 0; font-size: 14.5px; color: #14121a; }
  .esc-quien span { color: #9a9aa2; }

  .esc-editar { background: #fff; border: 1px solid #ece7dd; border-radius: 14px; margin-bottom: 18px; }
  .esc-editar summary { padding: 14px 18px; cursor: pointer; font-size: 14.5px; font-weight: 700; color: #14121a; }
  .esc-editar-cuerpo { padding: 0 18px 18px; max-width: 420px; }
  .esc-lbl { display: block; font-size: 12px; font-weight: 800; color: #6a6a74; margin-bottom: 5px; }
  .esc-input {
    width: 100%; padding: 10px 13px; border-radius: 12px; border: 2px solid #e6e1d8;
    font-size: 16px; font-family: inherit; color: #14121a; margin-bottom: 12px;
  }
  .esc-input:focus-visible { outline: none; border-color: var(--gold, #c9a227); }
  .esc-nota-pass { margin: 0 0 12px; font-size: 12.5px; color: #8a8578; }
  .esc-msg { margin: 10px 0 0; font-size: 13.5px; font-weight: 600; }
  .esc-msg[hidden] { display: none; }
  .esc-msg.ok { color: #2e7d52; }
  .esc-msg.err { color: #c8324c; }

  .esc-admin {
    margin: 0 0 18px; padding: 12px 16px; border-radius: 12px;
    background: #fdfaf3; border: 1px solid #efe4cd;
    font-size: 13.5px; font-weight: 600; color: var(--gold-dark, #a2823f);
  }

  .esc-h2 { font-size: 22px; font-weight: 800; letter-spacing: -.01em; color: #14121a; margin: 0 0 6px; }
  .esc-lead { max-width: 640px; margin: 0 0 18px; font-size: 13.5px; line-height: 1.6; color: #6a6a74; }
  .esc-tabla-wrap { overflow-x: auto; border: 1px solid #ece7dd; border-radius: 12px; }
  .esc-tabla { width: 100%; border-collapse: collapse; font-size: 13.5px; background: #fff; }
  .esc-tabla th { text-align: left; padding: 12px; background: #faf7f1; font-size: 11.5px; text-transform: uppercase; letter-spacing: .08em; color: var(--gold-dark, #a2823f); white-space: nowrap; }
  /* Las filas las crea el JS: sin el atributo de ámbito de Astro. */
  .esc-tabla :global(td) { padding: 10px 12px; border-top: 1px solid #f0ece4; }
  .esc-tabla :global(tbody tr:hover) { background: #fdfbf7; }
  .esc-tabla :global(td.pos) { width: 46px; font-weight: 800; color: var(--gold-dark, #a2823f); font-variant-numeric: tabular-nums; }
  .esc-tabla :global(td.titulo) { font-weight: 600; color: #14121a; }
  .esc-tabla :global(td.vacio) { text-align: center; padding: 30px; color: #8a8578; }
  .esc-tabla :global(td.acciones) { width: 74px; text-align: right; }
  .esc-tabla :global(.esc-quitar) {
    border: 1.5px solid #e6e1d8; background: #fff; border-radius: 999px;
    padding: 4px 12px; cursor: pointer; font-family: inherit; font-size: 12.5px;
    font-weight: 700; color: #6a6a74;
  }
  .esc-tabla :global(.esc-quitar:hover) { border-color: #c8324c; color: #c8324c; }
  .esc-tabla :global(.esc-quitar:disabled) { opacity: .5; cursor: default; }
  .esc-pie { margin: 18px 0 0; }
</style>
