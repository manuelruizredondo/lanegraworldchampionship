---
import { PROGRAMA, ROOM_LIST, I18N } from "@/data/programa.js";
import { ARTISTS } from "@/data/artists.js";
import { BIOS, PERFILES } from "@/data/artist-bios.js";
import { img } from "@/data/img.js";

const { lang = "es", comingSoon = false, wip = false } = Astro.props;
const t = I18N[lang] || I18N.es;

// Artistas: si el nombre de un artista aparece en el texto del profe, la card enlaza a su ficha
const artistList = ARTISTS[lang] || ARTISTS.es;
const norm = (s) => (s || "").toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g, "").trim();
const artistFor = (teacher) => {
  if (!teacher) return null;
  const tt = norm(teacher);
  let best = null;
  for (const a of artistList) {
    const n = norm(a.name);
    if (n.length >= 4 && tt.includes(n) && (!best || n.length > norm(best.name).length)) best = a;
  }
  return best || perfilIndex[tt] || null;
};
// Ponentes sin ficha en el cartel de artistas: se buscan por nombre exacto.
const perfilIndex = {};
for (const k in PERFILES) perfilIndex[norm(k)] = { name: k, ...PERFILES[k] };
// Índice por nombre EXACTO (sin coincidencias parciales), para separar parejas.
const exactIndex = {};
for (const a of artistList) exactIndex[norm(a.name)] = a;
for (const k in perfilIndex) if (!exactIndex[k]) exactIndex[k] = perfilIndex[k];
const exact = (n) => exactIndex[norm(n)] || null;
// "Angelo Rito y Maykel Fonts" son dos artistas; "Berra y Reyes" es una pareja
// con ficha propia. Solo se separa si el nombre completo NO tiene ficha y al
// menos una de las partes sí la tiene.
const splitTeachers = (p) => {
  if (exact(p)) return null;
  // El "·" manda sobre la "y": en "Korke y Judith · Irene y Tomás" son dos
  // parejas, no cuatro personas. Solo se parte por "y" si no hay ningún "·".
  const corte = p.includes("·") ? /\s*·\s*/ : /\s+(?:y|e|&)\s+/i;
  const parts = p.split(corte).map((x) => x.trim()).filter(Boolean);
  if (parts.length < 2) return null;
  const resolved = parts.map((x) => ({ text: x, a: exact(x) }));
  return resolved.some((r) => r.a) ? resolved : null;
};
const initials = (n) => (n || "").split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join("").toUpperCase();
// Descripción del artista (generada a partir de estilo + país; sustituible por biografía real)
// Índice de biografías por nombre normalizado (tolera mayúsculas/acentos)
const bioIndex = {};
for (const k in BIOS) { if (BIOS[k]) bioIndex[norm(k)] = BIOS[k]; }
const bioFor = (a, name) => {
  if (a) { const rb = bioIndex[norm(a.name)]; if (rb) return rb; } // biografía real
  if (a && a.country) {
    const [style, place] = a.country.split("|").map((s) => s.trim());
    const T = {
      es: `${a.name} es artista de ${style} de ${place}. Forma parte del cartel de La Negra Dance Festival, donde imparte sus talleres y sube al escenario en los shows del festival.`,
      en: `${a.name} is a ${style} artist from ${place}. Part of the La Negra Dance Festival line-up, teaching workshops and performing in the festival shows.`,
      it: `${a.name} è un artista di ${style} da ${place}. Fa parte del cast di La Negra Dance Festival, con i suoi workshop e gli show del festival.`,
    };
    return T[lang] || T.es;
  }
  const T2 = {
    es: `${name} forma parte del equipo de profes de La Negra Dance Festival, impartiendo clases durante el festival.`,
    en: `${name} is part of the La Negra Dance Festival teaching team during the festival.`,
    it: `${name} fa parte del team di insegnanti di La Negra Dance Festival durante il festival.`,
  };
  return T2[lang] || T2.es;
};

// Agrupa las sesiones de cada día por franja horaria (respetando el orden del PDF)
const days = PROGRAMA.map((d) => {
  const slots = [];
  d.sessions.forEach((s) => {
    const last = slots[slots.length - 1];
    if (last && last.t === s.t) last.items.push(s);
    else slots.push({ t: s.t, items: [s] });
  });
  return { ...d, slots };
});

const FILTER_KEYS = ["all", "fav", "taller", "bachata", "salsa", "master", "comp", "social"];
// Estilo del taller según el título: Bachata (RD) o Salsa (por defecto)
const isBachata = (s) => /bachata|dominican|bacano/i.test(s.n || "");
const title = (s) => (s.r === "full" ? (t.band[s.n] || s.n) : s.n);
const describe = (s) => {
  if (s.k === "taller") return s.l ? t.levelInfo[s.l] : t.desc.taller;
  return t.desc[s.k] || t.desc.taller;
};
---

<section class="pr-hero">
  <div class="container">
    {comingSoon && <span class="pr-soon-badge">{t.tallBadge}</span>}
    <p class="eyebrow dark">{comingSoon ? t.tallEyebrow : t.eyebrow}</p>
    <h1 class="script-title">{comingSoon ? t.tallH1 : t.h1}</h1>
    {comingSoon
      ? <p class="pr-sub">{t.tallSub}</p>
      : <p class="pr-sub"><a class="pr-pdf" href="/pdf/programacion-la-negra-2026.pdf" download>
          <svg viewBox="0 0 24 24" width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M7 10l5 5 5-5" /><path d="M12 15V3" /></svg>
          {t.pdfLink}
        </a></p>}
  </div>
</section>
{comingSoon && (
  <div class="pr-soon">
    <div class="container"><p>{t.tallBanner}</p></div>
  </div>
)}

<!-- Controles sticky: filtros + buscador, y abajo los días como tabs con barra deslizante -->
<div class:list={["pr-controls", { "pr-off": comingSoon, "pr-veil": wip }]}>
  <div class="container">
    <div class="pr-top">
    <label class="pr-search">
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m21 21-4.3-4.3"/></svg>
      <input type="search" id="pr-q" placeholder={t.search} autocomplete="off" aria-label={t.searchAria} />
    </label>
    <button class="pr-chip pr-chip-fav" data-filter="fav">
      <svg class="pr-chip-heart" viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
      <span>{t.filters.fav}</span>
      <span class="pr-fav-count" hidden>0</span>
    </button>
    </div>
    <div class="pr-filters" role="group" aria-label={t.filtersAria}>
      {FILTER_KEYS.filter((k) => k !== "fav").map((k, i) => (
        <button class={"pr-chip" + (i === 0 ? " active" : "")} data-filter={k}>
          <span>{t.filters[k]}</span>
        </button>
      ))}
    </div>
    <div class="pr-days" role="tablist" aria-label={t.daysAria}>
      {days.map((d, i) => (
        <button class={"pr-day-btn" + (i === 0 ? " active" : "")} data-day={i} role="tab" aria-selected={i === 0 ? "true" : "false"}>
          <span class="pr-day-name">{t.days[d.day]}</span>
          <span class="pr-day-date">{d.date}</span>
        </button>
      ))}
      <span class="pr-days-ink" aria-hidden="true"></span>
    </div>
  </div>
</div>

<section class:list={["pr-body", { "pr-off": comingSoon, "pr-veil": wip }]}>
  <div class="container">
    <p class="pr-fav-empty" hidden>{t.favEmpty}</p>
    {days.map((d, di) => (
      <div class="pr-day" id={`pr-day-${di}`} data-day-panel={di}>
        <h2 class="pr-day-head"><span class="pr-day-head-name">{t.days[d.day]}</span><span class="pr-day-head-date">{d.date}</span></h2>
        <div class="pr-colhead" aria-hidden="true">
          <span></span>
          <div>
            {ROOM_LIST.map((r) => (
              <div class="pr-chc-wrap">
                <button type="button" class={"pr-colhead-c pr-chc-" + r.key} data-room={r.key} aria-expanded="false">
                  <i class={"pr-dot pr-r-" + r.key}></i><span>{t.roomFull[r.key]}</span>
                  <svg class="pr-chc-i" viewBox="0 0 24 24" width="13" height="13" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9.5"/><path d="M12 11v5"/><path d="M12 7.6v.1"/></svg>
                </button>
                <div class={"pr-chc-pop rc-" + r.key} hidden>
                  <strong>{t.roomFull[r.key]}</strong>
                  <span>{t.roomLoc[r.key]}</span>
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="pr-timeline">
        {d.slots.map((slot) => { const tm = slot.t.split(/\s*[–—-]\s*/); return (
          <div class="pr-slot">
            <div class="pr-rail">
              <div class="pr-time pr-time-start"><span>{tm[0]}</span></div>
              {tm[1] && (
                <div class="pr-time pr-time-end">
                  {tm[1] === "amanecer"
                    /* Sol saliendo por el horizonte: las fiestas que acaban al amanecer */
                    ? <span class="pr-dawn" title={t.untilDawn} aria-label={t.untilDawn} role="img">
                        <svg viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                          <path d="M3 18h18" />
                          <path d="M7.5 18a4.5 4.5 0 0 1 9 0" />
                          <path d="M12 4.5v2M5.6 7.1l1.4 1.4M18.4 7.1l-1.4 1.4M1.5 13.5h2M20.5 13.5h2" />
                        </svg>
                      </span>
                    : <span>{tm[1]}</span>}
                </div>
              )}
            </div>
            <div class="pr-sessions">
              {slot.items.map((s) => (
                <article
                  class={"pr-card rc-" + s.r + " k-" + s.k + (s.r === "full" ? " pr-band" : "") + (s.k === "taller" ? (isBachata(s) ? " sp-b" : " sp-s") : "")}
                  data-kind={s.k}
                  data-estilo={s.r === "full" ? undefined : (isBachata(s) ? "bachata" : "salsa")}
                  data-text={((s.n || "") + " " + (s.p || "")).toLowerCase()}
                >
                  {s.r !== "full" && (s.k === "taller"
                    ? <span class={"pr-room pr-st-" + (isBachata(s) ? "b" : "s")}>{isBachata(s) ? "Bachata" : "Salsa"}</span>
                    /* Solo los tipos con color propio llevan esquina; el resto no pinta nada. */
                    : ["master", "comp", "social"].includes(s.k)
                      ? <span class={"pr-room pr-cn-" + s.k}>{t.kind[s.k]}</span>
                      : null)}
                  <div class="pr-card-in">
                    {s.r === "full" && (
                      <div class="pr-meta">
                        <span class={"pr-kind kb-" + s.k}>{t.kind[s.k]}</span>
                      </div>
                    )}
                    <span class="pr-card-time">{s.t}</span>
                    <h3 class="pr-title">{title(s)}</h3>
                    {s.p && (() => {
                      const p0 = s.p;
                      const multi = splitTeachers(s.p);
                      if (multi) return (
                        <p class="pr-teacher">
                          {multi.map((r, i) => (
                            <>
                              {i > 0 && (p0.includes("·") ? " · " : " y ")}
                              <button class="pr-teacher-link" type="button" data-aname={r.a ? r.a.name : r.text} data-aimg={r.a ? img(r.a.img) : ""} data-acountry={r.a ? r.a.country : ""} data-abio={bioFor(r.a, r.text)} data-aig={(r.a && r.a.ig) || ""} data-afb={(r.a && r.a.fb) || ""} data-ayt={(r.a && r.a.yt) || ""} data-aweb={(r.a && r.a.web) || ""} data-ainitials={initials(r.text)}>{r.text}</button>
                            </>
                          ))}
                        </p>
                      );
                      const a = artistFor(s.p);
                      const clickable = a || s.k === "taller" || s.k === "master";
                      if (!clickable) return <p class="pr-teacher">{s.p}</p>;
                      const dispName = a ? a.name : s.p.split("·")[0].trim();
                      return <button class="pr-teacher pr-teacher-link" type="button" data-aname={dispName} data-aimg={a ? img(a.img) : ""} data-acountry={a ? a.country : ""} data-abio={bioFor(a, dispName)} data-aig={(a && a.ig) || ""} data-afb={(a && a.fb) || ""} data-ayt={(a && a.yt) || ""} data-aweb={(a && a.web) || ""} data-ainitials={initials(dispName)}>{s.p}</button>;
                    })()}
                    {s.r !== "full" && (
                      <div class="pr-meta pr-meta-bottom">
                        <span class={"pr-roomtag pr-r-" + s.r}>{t.rooms[s.r]}</span>
                        {s.l && <span class={"pr-level lv-" + s.l.replace(/[^a-zA-ZñÑ]/g, "")}>{t.levels[s.l]}</span>}
                      </div>
                    )}
                    {s.r !== "full" && (
                      <div class="pr-card-detail">
                        <p class="pr-det-desc">{describe(s)}</p>
                        <p class="pr-det-loc"><span class={"pr-rname pr-rt-" + s.r}>{t.roomFull[s.r]}</span> · {t.roomLoc[s.r]}</p>
                      </div>
                    )}
                  </div>
                  {s.r !== "full" && <span class="pr-card-more" aria-hidden="true">+</span>}
                  {s.r !== "full" && (
                    <button class="pr-fav" type="button" aria-pressed="false" aria-label={t.favAria} data-fav={`${di}|${slot.t}|${s.r}|${s.n}`}>
                      <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                    </button>
                  )}
                </article>
              ))}
            </div>
          </div>
        ); })}
        </div>
        <p class="pr-empty" hidden>{t.empty} <button type="button" class="pr-reset">{t.reset}</button></p>
      </div>
    ))}
    <p class="pr-note">{t.note}</p>
  </div>
</section>

{wip && (
  <div class="pr-wip" role="status">
    <p class="pr-wip-txt">{t.wipTitle}</p>
    <p class="pr-wip-sub">{t.wipSub}</p>
    <div class="pr-wip-links">
      <a href="https://www.instagram.com/lanegraworldchampionship/" target="_blank" rel="noopener">Instagram</a>
      <a href="https://www.facebook.com/lanegradancefestival" target="_blank" rel="noopener">Facebook</a>
      <a href="https://www.youtube.com/user/LaNegraSalsa1" target="_blank" rel="noopener">YouTube</a>
    </div>
  </div>
)}

<!-- Modal de artista: se abre al tocar el nombre del profe (si es artista invitado) -->
<div class="pr-artist-modal" hidden>
  <div class="pr-am-backdrop" data-am-close></div>
  <div class="pr-am-card" role="dialog" aria-modal="true" aria-label="Artista">
    <button class="pr-am-close" type="button" data-am-close aria-label={t.close || "Cerrar"}>&times;</button>
    <div class="pr-am-media">
      <img class="pr-am-img" src="" alt="" hidden />
      <div class="pr-am-ph" hidden><span class="pr-am-initials"></span></div>
    </div>
    <div class="pr-am-body">
      <h3 class="pr-am-name"></h3>
      <p class="pr-am-country"></p>
      <p class="pr-am-bio"></p>
      <div class="pr-am-social"></div>
    </div>
  </div>
</div>

<script>
  const dayBtns = [...document.querySelectorAll(".pr-day-btn")];
  const panels = [...document.querySelectorAll("[data-day-panel]")];
  const chips = [...document.querySelectorAll(".pr-chip")];
  const q = document.getElementById("pr-q");
  // Filtros múltiples. Dentro de un mismo grupo suman (bachata O salsa) y entre
  // grupos restringen (bachata Y masterclass = masterclasses de bachata).
  const ESTILOS = ["bachata", "salsa"];
  const TIPOS = ["taller", "master", "comp", "social"];
  const filtros = new Set();
  let query = "";
  const controlsEl = document.querySelector(".pr-controls");

  // ── Favoritos (persisten en el navegador con localStorage) ──
  const FAV_KEY = "lanegra:programa:favs";
  const loadFavs = () => { try { return new Set(JSON.parse(localStorage.getItem(FAV_KEY) || "[]")); } catch (e) { return new Set(); } };
  const favs = loadFavs();
  const saveFavs = () => { try { localStorage.setItem(FAV_KEY, JSON.stringify([...favs])); } catch (e) {} };
  const favCountEl = document.querySelector(".pr-fav-count");
  const favEmptyEl = document.querySelector(".pr-fav-empty");
  const favBtns = [...document.querySelectorAll(".pr-fav")];
  const syncFavCount = () => {
    if (!favCountEl) return;
    favCountEl.textContent = favs.size;
    favCountEl.hidden = favs.size === 0;
  };
  const markFavs = () => favBtns.forEach((btn) => {
    const on = favs.has(btn.dataset.fav);
    btn.classList.toggle("is-fav", on);
    btn.setAttribute("aria-pressed", on ? "true" : "false");
  });
  favBtns.forEach((btn) => btn.addEventListener("click", (e) => {
    e.stopPropagation(); // no expandir la tarjeta al tocar el corazón
    const id = btn.dataset.fav;
    if (favs.has(id)) favs.delete(id); else favs.add(id);
    saveFavs();
    const on = favs.has(id);
    btn.classList.toggle("is-fav", on);
    btn.setAttribute("aria-pressed", on ? "true" : "false");
    btn.classList.remove("pr-fav-pop"); void btn.offsetWidth; if (on) btn.classList.add("pr-fav-pop");
    syncFavCount();
    if (filtros.has("fav")) apply();
  }));
  markFavs();
  syncFavCount();
  const headerH = () => parseInt(getComputedStyle(document.documentElement).getPropertyValue("--header-h")) || 88;
  // Publica la altura de la barra de controles para fijar la cabecera de día justo debajo
  const setControlsH = () => document.documentElement.style.setProperty("--controls-h", controlsEl.offsetHeight + "px");
  setControlsH();
  window.addEventListener("resize", setControlsH);

  const apply = () => {
    const favMode = filtros.has("fav");
    const estilos = ESTILOS.filter((e) => filtros.has(e));
    const tipos = TIPOS.filter((k) => filtros.has(k));
    panels.forEach((panel) => {
      let visible = 0;
      panel.querySelectorAll(".pr-slot").forEach((slot) => {
        let shown = 0;
        slot.querySelectorAll(".pr-card").forEach((card) => {
          const favBtn = card.querySelector(".pr-fav");
          const okFav = !favMode || !!(favBtn && favs.has(favBtn.dataset.fav));
          const okEstilo = !estilos.length || estilos.includes(card.dataset.estilo);
          const okTipo = !tipos.length || tipos.some((k) => card.dataset.kind === k
            || (k === "social" && card.dataset.kind === "meal"));
          const okText = !query || (card.dataset.text || "").includes(query);
          const ok = okFav && okEstilo && okTipo && okText;
          card.hidden = !ok;
          if (ok) shown++;
        });
        slot.hidden = shown === 0;
        visible += shown;
      });
      const empty = panel.querySelector(".pr-empty");
      // En modo favoritos usamos un único mensaje global, no el de cada día
      if (empty) empty.hidden = favMode || visible !== 0;
    });
    if (favEmptyEl) favEmptyEl.hidden = !(favMode && favs.size === 0);
  };

  // Barra deslizante (ink) bajo la pestaña del día activo
  const daysEl = document.querySelector(".pr-days");
  const ink = document.querySelector(".pr-days-ink");
  const moveInk = (i) => {
    const btn = dayBtns[i];
    if (!btn || !ink) return;
    ink.style.width = btn.offsetWidth + "px";
    ink.style.transform = "translateX(" + btn.offsetLeft + "px)";
  };

  // Todos los días apilados. Click en una pestaña -> scroll suave a ese día.
  const scrollToDay = (i) => {
    const target = Math.max(0, Math.round(panels[i].getBoundingClientRect().top + window.scrollY - headerH() - controlsEl.offsetHeight - 6));
    window.scrollTo({ top: target, behavior: "smooth" });
  };
  const activateDay = (i) => {
    lastActive = i;
    dayBtns.forEach((x, idx) => { const on = idx === i; x.classList.toggle("active", on); x.setAttribute("aria-selected", on ? "true" : "false"); });
    moveInk(i);
  };
  dayBtns.forEach((b) => b.addEventListener("click", () => { const i = +b.dataset.day; activateDay(i); scrollToDay(i); }));

  // Scroll-spy: al hacer scroll, resalta el día que se está viendo y desliza la barra
  let spyTick = false, lastActive = -1;
  const spy = () => {
    spyTick = false;
    const y = window.scrollY + headerH() + controlsEl.offsetHeight + 24;
    let active = 0;
    panels.forEach((p, i) => { if (p.getBoundingClientRect().top + window.scrollY <= y) active = i; });
    if (active !== lastActive) {
      lastActive = active;
      dayBtns.forEach((b, i) => { const on = i === active; b.classList.toggle("active", on); b.setAttribute("aria-selected", on ? "true" : "false"); });
      moveInk(active);
      // mantén visible la pestaña activa dentro del carrusel de días
      const btn = dayBtns[active];
      if (btn && daysEl) daysEl.scrollTo({ left: btn.offsetLeft - 24, behavior: "smooth" });
    }
  };
  window.addEventListener("scroll", () => { if (!spyTick) { spyTick = true; requestAnimationFrame(spy); } }, { passive: true });
  window.addEventListener("resize", () => { moveInk(Math.max(0, lastActive)); spy(); });
  window.addEventListener("load", () => moveInk(Math.max(0, lastActive)));
  // "Todo" se enciende solo cuando no hay ningún filtro puesto
  const pintarChips = () => chips.forEach((x) => x.classList.toggle("active",
    x.dataset.filter === "all" ? filtros.size === 0 : filtros.has(x.dataset.filter)));

  chips.forEach((c) => c.addEventListener("click", () => {
    const f = c.dataset.filter;
    if (f === "all") filtros.clear();
    else if (filtros.has(f)) filtros.delete(f);   // volver a pulsarlo lo quita
    else filtros.add(f);
    pintarChips();
    apply();
  }));
  pintarChips();
  q.addEventListener("input", () => { query = q.value.trim().toLowerCase(); apply(); });

  // Salas: al pulsar el nombre de una columna se abre una burbuja con su ubicación
  const chBtns = [...document.querySelectorAll(".pr-colhead-c")];
  const cerrarPop = () => chBtns.forEach((b) => {
    b.setAttribute("aria-expanded", "false");
    const pop = b.parentElement.querySelector(".pr-chc-pop");
    if (pop) pop.hidden = true;
  });
  chBtns.forEach((b) => b.addEventListener("click", (e) => {
    e.stopPropagation();
    const pop = b.parentElement.querySelector(".pr-chc-pop");
    const abierta = !pop.hidden;
    cerrarPop();
    if (!abierta) { pop.hidden = false; b.setAttribute("aria-expanded", "true"); }
  }));
  document.addEventListener("click", cerrarPop);
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") cerrarPop(); });

  // Modal de artista: al tocar el nombre del profe (si es artista) muestra foto + info
  const amodal = document.querySelector(".pr-artist-modal");
  const amImg = amodal.querySelector(".pr-am-img");
  const amPh = amodal.querySelector(".pr-am-ph");
  const amInitials = amodal.querySelector(".pr-am-initials");
  const amName = amodal.querySelector(".pr-am-name");
  const amCountry = amodal.querySelector(".pr-am-country");
  const amBio = amodal.querySelector(".pr-am-bio");
  const amSocial = amodal.querySelector(".pr-am-social");
  // La web se etiqueta con su propio dominio (p. ej. "digitalstrategy.es").
  const SOCIALS = [["aig", "Instagram"], ["ayt", "YouTube"], ["afb", "Facebook"], ["aweb", null]];
  const openArtist = (btn) => {
    const hasImg = !!btn.dataset.aimg;
    amImg.hidden = !hasImg; amPh.hidden = hasImg;
    if (hasImg) { amImg.src = btn.dataset.aimg; amImg.alt = btn.dataset.aname || ""; }
    else { amInitials.textContent = btn.dataset.ainitials || "•"; }
    amName.textContent = btn.dataset.aname || "";
    amCountry.textContent = btn.dataset.acountry || "";
    amCountry.hidden = !btn.dataset.acountry;
    amBio.textContent = btn.dataset.abio || "";
    amBio.hidden = !btn.dataset.abio;
    amSocial.innerHTML = "";
    SOCIALS.forEach(([k, label]) => {
      const url = btn.dataset[k];
      if (url) {
        const a = document.createElement("a");
        a.href = url; a.target = "_blank"; a.rel = "noopener";
        a.className = "pr-am-link";
        a.textContent = label || url.replace(/^https?:\/\//, "").replace(/^www\./, "").replace(/\/$/, "");
        amSocial.appendChild(a);
      }
    });
    amSocial.hidden = amSocial.children.length === 0;
    amodal.hidden = false;
    document.body.style.overflow = "hidden";
    amLastFocus = btn; // para devolver el foco al cerrar (solo si se abrió con teclado)
    const closeBtn = amodal.querySelector(".pr-am-close");
    if (closeBtn) closeBtn.focus();
  };
  let amLastFocus = null;
  let amByKeyboard = false;
  const closeArtist = () => {
    if (amodal.hidden) return;
    amodal.hidden = true; document.body.style.overflow = "";
    // Devolver el foco al botón solo si se llegó con teclado: hacerlo tras un
    // clic de ratón dibujaría el anillo de foco sin que nadie lo haya pedido.
    if (amByKeyboard && amLastFocus && amLastFocus.focus) amLastFocus.focus();
    amLastFocus = null; amByKeyboard = false;
  };
  // Alto real del bloque de filtros, para colgar de él la cabecera de salas
  const ctrl = document.querySelector(".pr-controls");
  if (ctrl) {
    const medir = () => document.documentElement.style.setProperty("--pr-ctrl-h", ctrl.offsetHeight + "px");
    medir();
    if (window.ResizeObserver) new ResizeObserver(medir).observe(ctrl);
    window.addEventListener("resize", medir);
  }
  document.querySelectorAll(".pr-teacher-link").forEach((b) => b.addEventListener("click", (e) => { e.stopPropagation(); amByKeyboard = e.detail === 0; openArtist(b); }));
  amodal.querySelectorAll("[data-am-close]").forEach((x) => x.addEventListener("click", closeArtist));
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") closeArtist(); });
  // Foco atrapado dentro de la modal (Tab cicla entre sus elementos)
  amodal.addEventListener("keydown", (e) => {
    if (e.key !== "Tab" || amodal.hidden) return;
    const foci = [...amodal.querySelectorAll('button, a[href], [tabindex]:not([tabindex="-1"])')].filter((el) => !el.hidden && el.offsetParent !== null);
    if (!foci.length) return;
    const first = foci[0], last = foci[foci.length - 1];
    if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
    else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
  });

  // Click en una tarjeta -> crece y muestra el texto explicativo
  document.querySelector(".pr-body").addEventListener("click", (e) => {
    const card = e.target.closest(".pr-card:not(.pr-band)");
    if (card) card.classList.toggle("expanded");
  });
  document.querySelectorAll(".pr-reset").forEach((r) => r.addEventListener("click", () => {
    filtros.clear(); query = ""; q.value = "";
    pintarChips();
    apply();
  }));
  apply();
  spy();
</script>

