---
// Cuenta de usuario: entrar con Google (sin contraseñas que guardar) y salir.
//
// Expone en `window.laNegraCuenta` una API mínima para el resto de la página:
//   .cliente()           → el cliente de Supabase, cargado solo cuando hace falta
//   .sesion()            → la sesión actual, o null
//   .alCambiar(fn)       → avisa cuando se entra o se sale
//   .pedirEntrar()       → abre el panel de acceso
//
// La librería se carga desde CDN la primera vez que se usa, para no cargarle
// 40 KB a quien solo entra a mirar el horario.
import { SUPABASE_URL, SUPABASE_ANON_KEY, SUPABASE_CDN, CUENTA_I18N } from "@/data/supabase.js";

const { lang = "es" } = Astro.props;
const t = CUENTA_I18N[lang] || CUENTA_I18N.es;
---

<div class="cu" data-cuenta hidden>
  <div class="cu-fondo" data-cu-cerrar></div>
  <div class="cu-caja" role="dialog" aria-modal="true" aria-labelledby="cu-t">
    <button type="button" class="cu-x" data-cu-cerrar aria-label={t.cerrar}>
      <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M18 6L6 18"/><path d="M6 6l12 12"/></svg>
    </button>

    <div data-cu-fuera>
      <h3 class="cu-t" id="cu-t">{t.titulo}</h3>
      <p class="cu-lead">{t.lead}</p>

      <button type="button" class="cu-google" data-cu-google>
        <svg viewBox="0 0 48 48" width="19" height="19" aria-hidden="true">
          <path fill="#4285F4" d="M45.1 24.5c0-1.6-.1-2.7-.4-3.9H24v7.1h12.1c-.2 1.8-1.6 4.6-4.5 6.5l-.1.3 6.5 5 .4.1c4.1-3.8 6.7-9.4 6.7-15.1"/>
          <path fill="#34A853" d="M24 46c5.9 0 10.9-2 14.5-5.3l-6.9-5.4c-1.8 1.3-4.3 2.2-7.6 2.2-5.8 0-10.7-3.8-12.5-9.1l-.3.1-6.7 5.2-.1.3C7.9 41 15.4 46 24 46"/>
          <path fill="#FBBC05" d="M11.5 28.4c-.5-1.4-.7-2.9-.7-4.4s.3-3 .7-4.4v-.3l-6.8-5.3-.2.1C3 17 2.2 20.4 2.2 24s.8 7 2.3 9.9z"/>
          <path fill="#EB4335" d="M24 10.5c4.1 0 6.9 1.8 8.5 3.3l6.2-6C34.9 4.4 29.9 2 24 2 15.4 2 7.9 7 4.5 14.1l7 5.5c1.8-5.3 6.7-9.1 12.5-9.1"/>
        </svg>
        <span>{t.google}</span>
      </button>

      <p class="cu-o" data-cu-o><span>{t.oBien}</span></p>

      {/* El mismo formulario sirve para entrar, darse de alta y recuperar la
          contraseña; cambia el título, el botón y qué campos se ven. */}
      <form class="cu-form" data-cu-form>
        <label class="cu-lbl" for="cu-email">{t.campoEmail}</label>
        <input class="cu-input" id="cu-email" type="email" autocomplete="email"
               inputmode="email" placeholder="tu@email.com" required />

        <div data-cu-campo-pass>
          <label class="cu-lbl" for="cu-pass">{t.campoPass}</label>
          <input class="cu-input" id="cu-pass" type="password" autocomplete="current-password"
                 minlength="8" />
        </div>

        <button type="submit" class="cu-btn" data-cu-enviar>{t.entrarPass}</button>
      </form>

      <p class="cu-links">
        <button type="button" class="cu-link" data-cu-modo="alta">{t.crearCuenta}</button>
        <button type="button" class="cu-link" data-cu-modo="olvido">{t.olvide}</button>
        <button type="button" class="cu-link" data-cu-modo="entrar" hidden>{t.yaTengo}</button>
      </p>

      <p class="cu-nota">{t.nota} <a href={t.rutaPrivacidad}>{t.privacidad}</a></p>
    </div>

    <div data-cu-dentro hidden>
      <h3 class="cu-t">{t.miCuenta}</h3>
      <p class="cu-lead"><span class="cu-quien">{t.sesionDe}</span> <strong data-cu-email></strong></p>
      <button type="button" class="cu-btn cu-btn-sec" data-cu-salir>{t.salir}</button>
    </div>

    <p class="cu-msg" data-cu-msg hidden role="status"></p>
  </div>
</div>

<script is:inline define:vars={{ URL_SB: SUPABASE_URL, KEY: SUPABASE_ANON_KEY, CDN: SUPABASE_CDN, T: t }}>
  (function () {
    const panel = document.querySelector("[data-cuenta]");
    if (!panel) return;
    const fuera = panel.querySelector("[data-cu-fuera]");
    const dentro = panel.querySelector("[data-cu-dentro]");
    const msg = panel.querySelector("[data-cu-msg]");

    let cliente = null;
    let sesion = null;
    const oyentes = [];

    const aviso = (txt, err) => {
      msg.textContent = txt || "";
      msg.className = "cu-msg" + (err ? " err" : " ok");
      msg.hidden = !txt;
    };

    async function obtenerCliente() {
      if (cliente) return cliente;
      const { createClient } = await import(CDN);
      cliente = createClient(URL_SB, KEY, {
        auth: { persistSession: true, autoRefreshToken: true, detectSessionInUrl: true },
      });
      const { data } = await cliente.auth.getSession();
      sesion = data.session || null;
      cliente.auth.onAuthStateChange((_evt, s) => {
        sesion = s || null;
        pintar();
        oyentes.forEach((fn) => { try { fn(sesion); } catch (e) {} });
      });
      return cliente;
    }

    function pintar() {
      const hay = !!sesion;
      fuera.hidden = hay;
      dentro.hidden = !hay;
      if (hay) panel.querySelector("[data-cu-email]").textContent = sesion.user.email || "";
      document.querySelectorAll("[data-cu-abrir]").forEach((b) => {
        b.textContent = hay ? T.miCuenta : T.entrar;
      });
      document.documentElement.classList.toggle("con-sesion", hay);
    }

    const abrir = async () => {
      await obtenerCliente();
      pintar();
      aviso("");
      panel.hidden = false;
      if (typeof pintarModo === "function") { modo = "entrar"; pintarModo(); }
    };
    const cerrar = () => { panel.hidden = true; aviso(""); };

    panel.querySelectorAll("[data-cu-cerrar]").forEach((b) => b.addEventListener("click", cerrar));
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) cerrar(); });
    document.addEventListener("click", (e) => {
      if (e.target.closest("[data-cu-abrir]")) { e.preventDefault(); abrir(); }
    });

    panel.querySelector("[data-cu-google]").addEventListener("click", async () => {
      aviso("");
      try {
        const c = await obtenerCliente();
        const { error } = await c.auth.signInWithOAuth({
          provider: "google",
          options: { redirectTo: window.location.href.split("#")[0] },
        });
        if (error) throw error;
        // Si no hay error, el navegador se va a Google y vuelve con la sesión.
      } catch (e) {
        aviso((e && e.message) || T.errGoogle, true);
      }
    });

    // ── Entrar / crear cuenta / recuperar, con email y contraseña ─────────
    const form = panel.querySelector("[data-cu-form]");
    const inEmail = panel.querySelector("#cu-email");
    const inPass = panel.querySelector("#cu-pass");
    const campoPass = panel.querySelector("[data-cu-campo-pass]");
    const bEnviar = panel.querySelector("[data-cu-enviar]");
    const titulo = panel.querySelector("#cu-t");
    const lead = panel.querySelector(".cu-lead");
    const google = panel.querySelector("[data-cu-google]");
    const separador = panel.querySelector("[data-cu-o]");
    const enlaces = panel.querySelectorAll("[data-cu-modo]");
    const TITULO_INICIAL = titulo.textContent;
    const LEAD_INICIAL = lead.textContent;
    let modo = "entrar";

    function pintarModo() {
      const alta = modo === "alta", olvido = modo === "olvido";
      titulo.textContent = alta ? T.tituloAlta : olvido ? T.tituloOlvido : TITULO_INICIAL;
      lead.textContent = alta ? T.leadAlta : olvido ? T.leadOlvido : LEAD_INICIAL;
      campoPass.hidden = olvido;
      inPass.required = !olvido;
      inPass.setAttribute("autocomplete", alta ? "new-password" : "current-password");
      bEnviar.textContent = alta ? T.crearCuenta : olvido ? T.enviarEnlace : T.entrarPass;
      // Con Google solo tiene sentido en la pantalla de entrar.
      google.hidden = olvido;
      separador.hidden = olvido;
      enlaces.forEach((b) => { b.hidden = (b.dataset.cuModo === modo) || (modo === "entrar" && b.dataset.cuModo === "entrar"); });
      if (modo !== "entrar") panel.querySelector('[data-cu-modo="entrar"]').hidden = false;
      aviso("");
    }

    enlaces.forEach((b) => b.addEventListener("click", () => { modo = b.dataset.cuModo; pintarModo(); }));

    // Supabase contesta en inglés; aquí se traduce a algo que se entienda.
    function traduce(e) {
      const m = ((e && e.message) || "").toLowerCase();
      if (m.includes("invalid login credentials")) return T.errCredenciales;
      if (m.includes("email not confirmed")) return T.errSinConfirmar;
      if (m.includes("already registered") || m.includes("already been registered")) return T.errYaExiste;
      if (m.includes("password should be at least")) return T.errPassCorta;
      if (m.includes("invalid email") || m.includes("unable to validate email")) return T.errEmailMal;
      return (e && e.message) || T.errGenerico;
    }

    form.addEventListener("submit", async (e) => {
      e.preventDefault();
      const email = inEmail.value.trim();
      const pass = inPass.value;
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { aviso(T.errEmailMal, true); inEmail.focus(); return; }
      if (modo !== "olvido" && pass.length < 8) { aviso(T.errPassCorta, true); inPass.focus(); return; }

      const antes = bEnviar.textContent;
      bEnviar.disabled = true;
      bEnviar.textContent = T.trabajando;
      try {
        const c = await obtenerCliente();
        if (modo === "entrar") {
          const { error } = await c.auth.signInWithPassword({ email, password: pass });
          if (error) throw error;
          cerrar();
        } else if (modo === "alta") {
          const { data, error } = await c.auth.signUp({
            email, password: pass,
            options: { emailRedirectTo: window.location.href.split("#")[0] },
          });
          if (error) throw error;
          // Si el proyecto exige confirmar el email no hay sesión todavía.
          if (data && data.session) { aviso(T.altaLista, false); setTimeout(cerrar, 1200); }
          else aviso(T.altaConfirma, false);
        } else {
          const { error } = await c.auth.resetPasswordForEmail(email, {
            redirectTo: window.location.origin + window.location.pathname,
          });
          if (error) throw error;
          aviso(T.olvidoEnviado, false);
        }
      } catch (err) {
        aviso(traduce(err), true);
      }
      bEnviar.disabled = false;
      bEnviar.textContent = antes;
    });

    panel.querySelector("[data-cu-salir]").addEventListener("click", async () => {
      const c = await obtenerCliente();
      await c.auth.signOut();
      cerrar();
    });

    // API para el resto de la página
    window.laNegraCuenta = {
      cliente: obtenerCliente,
      sesion: () => sesion,
      alCambiar: (fn) => { oyentes.push(fn); if (sesion) fn(sesion); },
      pedirEntrar: abrir,
    };

    // Al volver de Google la URL trae el token: hay que arrancar el cliente ya
    // para que lo canjee y se limpie la barra de direcciones.
    if (location.hash.includes("access_token") || location.search.includes("code=")) {
      obtenerCliente().then(() => {
        pintar();
        history.replaceState(null, "", location.pathname + location.search.replace(/[?&]code=[^&]*/, ""));
      });
    } else if (localStorage.getItem("sb-" + URL_SB.split("//")[1].split(".")[0] + "-auth-token")) {
      // Ya había sesión guardada: se restaura sin esperar a que pulsen nada.
      obtenerCliente().then(pintar);
    }
  })();
</script>

<style>
  .cu { position: fixed; inset: 0; z-index: 3200; display: flex; align-items: center; justify-content: center; padding: 20px; }
  .cu[hidden] { display: none; }
  .cu-fondo { position: absolute; inset: 0; background: rgba(15, 11, 30, .62); -webkit-backdrop-filter: blur(4px); backdrop-filter: blur(4px); }
  .cu-caja {
    position: relative; z-index: 1; width: 100%; max-width: 420px; background: #fff;
    border-radius: 20px; padding: 28px 24px 22px; box-shadow: 0 30px 80px rgba(0, 0, 0, .42);
  }
  .cu-x {
    position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; border-radius: 50%;
    border: 0; background: #f0ede7; color: #6a6a74; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
  }
  .cu-x:hover { background: #e6e1d8; color: #14121a; }
  .cu-t { margin: 0 30px 8px 0; font-size: 20px; font-weight: 800; letter-spacing: -.01em; color: #14121a; }
  .cu-lead { margin: 0 0 18px; font-size: 14px; line-height: 1.5; color: #6a6a74; }
  .cu-quien { color: #9a9aa2; }
  .cu-google {
    width: 100%; display: flex; align-items: center; justify-content: center; gap: 10px;
    padding: 12px 14px; border-radius: 999px; border: 2px solid #e0dcd4; background: #fff;
    font-family: inherit; font-size: 15px; font-weight: 700; color: #14121a; cursor: pointer;
    transition: border-color .15s ease, background .15s ease;
  }
  .cu-google:hover { border-color: #c9c3b8; background: #fbfaf8; }
  .cu-google[hidden] { display: none; }

  .cu-o { display: flex; align-items: center; gap: 10px; margin: 16px 0 14px; }
  .cu-o[hidden] { display: none; }
  .cu-o::before, .cu-o::after { content: ""; flex: 1; height: 1px; background: #ece7dd; }
  .cu-o span { font-size: 12px; color: #9a9aa2; }

  .cu-form { display: block; }
  .cu-lbl { display: block; font-size: 12px; font-weight: 800; letter-spacing: .02em; color: #6a6a74; margin-bottom: 5px; }
  .cu-input {
    width: 100%; padding: 11px 13px; border-radius: 12px; border: 2px solid #e6e1d8;
    font-size: 16px; font-family: inherit; color: #14121a; margin-bottom: 12px;
  }
  .cu-input:focus-visible { outline: none; border-color: var(--gold, #c9a227); }
  .cu-form [data-cu-campo-pass][hidden] { display: none; }

  .cu-links { display: flex; flex-wrap: wrap; gap: 14px; margin: 12px 0 0; }
  .cu-link {
    border: 0; background: none; padding: 0; cursor: pointer; font-family: inherit;
    font-size: 13px; font-weight: 700; color: var(--gold-dark, #a2823f);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .cu-link[hidden] { display: none; }
  .cu-link:hover { color: #14121a; }

  .cu-btn {
    width: 100%; margin-top: 14px; padding: 13px 10px; border-radius: 999px;
    border: 2px solid #14121a; background: #fff; color: #14121a;
    font-family: inherit; font-size: 15px; font-weight: 700; cursor: pointer;
  }
  .cu-btn:hover { background: #f4f1ea; }

  .cu-msg { margin: 14px 0 0; font-size: 13.5px; font-weight: 600; line-height: 1.45; }
  .cu-msg[hidden] { display: none; }
  .cu-msg.ok { color: #2e7d52; }
  .cu-msg.err { color: #c8324c; }
  .cu-nota { margin: 12px 0 0; font-size: 12px; color: #9a9aa2; line-height: 1.45; }
  .cu-nota a { color: #6a6a74; text-decoration: underline; }
</style>
