---
// Demostración del horario: al bajar, la maqueta de la izquierda va enseñando
// qué se puede hacer (filtrar, buscar, guardar favoritos, ver las cuatro salas).
// No es un vídeo: es la propia interfaz en miniatura, así que pesa nada y se ve
// nítida en cualquier pantalla.
const { lang = "es" } = Astro.props;

const T = {
  es: {
    h2: "Programación 2026",
    pasos: [
      { t: "Filtra por lo que te gusta", d: "Bachata, salsa, masterclasses, el Mundial o las fiestas. Un toque y te quedas solo con lo que te interesa." },
      { t: "Busca taller o profesor", d: "Escribe un nombre y aparecen todas sus clases, el día y la sala. Sin recorrer los cinco días a mano." },
      { t: "Guarda tus favoritos", d: "Marca las clases con el corazón y quédate solo con las tuyas. Se quedan guardadas en tu móvil." },
      { t: "Mira las cuatro salas", d: "En pantalla grande verás a la vez qué pasa en el Gran Salón, el Piano Bar y las salas 1 y 2." },
    ],
    chips: ["Todo", "Bachata", "Salsa", "El Mundial"],
    dias: ["Mié", "Jue", "Vie", "Sáb", "Dom"],
    buscar: "Buscar taller o profe…",
    busca1: "Maykel", busca2: "Solistas",
    favs: "Mis favoritos",
    salas: ["Gran Salón", "Piano Bar", "Sala 1", "Sala 2"],
    cta: "Ver la programación", pdf: "Descargar en PDF",
  },
  en: {
    h2: "2026 schedule",
    pasos: [
      { t: "Filter what you like", d: "Bachata, salsa, masterclasses, the World Championship or the parties. One tap and you keep only what matters to you." },
      { t: "Search class or teacher", d: "Type a name and every one of their classes shows up, with the day and the room. No scrolling through five days." },
      { t: "Save your favourites", d: "Tap the heart on a class and keep only yours. They stay saved on your phone." },
      { t: "See all four rooms", d: "On a big screen you see at once what is on in the Gran Salón, the Piano Bar and rooms 1 and 2." },
    ],
    chips: ["All", "Bachata", "Salsa", "World Cup"],
    dias: ["Wed", "Thu", "Fri", "Sat", "Sun"],
    buscar: "Search class or teacher…",
    busca1: "Maykel", busca2: "Solistas",
    favs: "My favourites",
    salas: ["Gran Salón", "Piano Bar", "Room 1", "Room 2"],
    cta: "See the schedule", pdf: "Download as PDF",
  },
  it: {
    h2: "Programma 2026",
    pasos: [
      { t: "Filtra quello che ti piace", d: "Bachata, salsa, masterclass, il Mondiale o le feste. Un tocco e resti solo con ciò che ti interessa." },
      { t: "Cerca lezione o insegnante", d: "Scrivi un nome e compaiono tutte le sue lezioni, con giorno e sala. Senza scorrere i cinque giorni a mano." },
      { t: "Salva i preferiti", d: "Tocca il cuore su una lezione e tieni solo le tue. Restano salvate sul tuo telefono." },
      { t: "Guarda le quattro sale", d: "Su schermo grande vedi insieme cosa succede nel Gran Salón, nel Piano Bar e nelle sale 1 e 2." },
    ],
    chips: ["Tutto", "Bachata", "Salsa", "Mondiale"],
    dias: ["Mer", "Gio", "Ven", "Sab", "Dom"],
    buscar: "Cerca lezione o insegnante…",
    busca1: "Maykel", busca2: "Solistas",
    favs: "I miei preferiti",
    salas: ["Gran Salón", "Piano Bar", "Sala 1", "Sala 2"],
    cta: "Vedi il programma", pdf: "Scarica in PDF",
  },
};
const t = T[lang] || T.es;
const HREF = { es: "/talleres/", en: "/en/workshops/", it: "/it/workshops/" };

// Las cuatro tarjetas de la maqueta. `sala` decide su columna en el paso 4.
const CARDS = [
  { n: "Afro-Cuban Footwork & Body Movement", p: "Maykel Fonts", sala: "pb", estilo: "salsa", busca: "maykel" },
  { n: "Bachata Trilogía: tradicional y moderna", p: "Andrés y Jessica", sala: "s1", estilo: "bachata", busca: "" },
  { n: "Salsa: Semifinal Solistas Chicos", p: "", sala: "gs", estilo: "salsa", busca: "solistas" },
  { n: "Bachata Sensual: Lead & Follow", p: "Berra y Reyes", sala: "s2", estilo: "bachata", busca: "" },
];
---

<section class="pd" data-step="0">
  <div class="pd-scroll">
    <div class="pd-sticky">
      <div class="p-container pd-head">
        <h2 class="p-h2">{t.h2}</h2>
      </div>
      <div class="p-container pd-grid">

        <!-- Puntos de progreso -->
        <div class="pd-dots" aria-hidden="true">
          {t.pasos.map((_, i) => <span class="pd-dot" data-dot={i}></span>)}
        </div>

        <!-- Maqueta del horario -->
        <div class="pd-mock" aria-hidden="true">
          <span class="pd-tap"></span>
          <div class="pd-bar">
            <div class="pd-search" data-b1={t.busca1} data-b2={t.busca2}><em>{t.buscar}</em><strong></strong><span class="pd-cursor"></span></div>
            <div class="pd-chips">
              {t.chips.map((c, i) => <span class={"pd-chip pd-chip-" + i} data-c={["todo", "bachata", "salsa", "mundial"][i]}>{c}</span>)}
              <span class="pd-chip pd-chip-fav" data-c="fav"><i></i>{t.favs}<b>0</b></span>
            </div>
          </div>
          <div class="pd-days">{t.dias.map((d, i) => <span class={"pd-day" + (i === 1 ? " on" : "")}>{d}</span>)}</div>
          <div class="pd-rooms">{t.salas.map((s, i) => <span class={"pd-room pd-room-" + i}>{s}</span>)}</div>
          <div class="pd-cards">
            {CARDS.map((c, i) => (
              <article class={`pd-card pd-c${i} e-${c.estilo} r-${c.sala}`} data-e={c.estilo} data-b={c.busca}>
                <span class="pd-card-t">{c.n}</span>
                {c.p && <span class="pd-card-p">{c.p}</span>}
                <span class="pd-heart">
                  <svg viewBox="0 0 24 24" width="15" height="15" aria-hidden="true"><path d="M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"/></svg>
                </span>
              </article>
            ))}
          </div>
        </div>

        <!-- Pasos -->
        <div class="pd-steps">
          {t.pasos.map((s, i) => (
            <div class="pd-step" data-i={i}>
              <h3>{s.t}</h3>
              <p>{s.d}</p>
            </div>
          ))}
        </div>

      </div>

      <div class="p-container pd-ctas">
        <a class="p-btn p-btn-dark" href={HREF[lang] || HREF.es}>{t.cta}</a>
        <a class="pd-pdf" href="/pdf/programacion-la-negra-2026.pdf" download>
          <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4" /><path d="M7 10l5 5 5-5" /><path d="M12 15V3" /></svg>
          {t.pdf}
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const pd = document.querySelector(".pd");
  if (pd) {
    const total = pd.querySelectorAll(".pd-step").length;
    const scroll = pd.querySelector(".pd-scroll");
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");
    const ancho = window.matchMedia("(min-width: 900px)");
    let paso = -1;
    const mock = pd.querySelector(".pd-mock");
    const tap = pd.querySelector(".pd-tap");
    const busca = pd.querySelector(".pd-search");
    const escrito = busca.querySelector("strong");
    const chips = [...pd.querySelectorAll(".pd-chip")];
    const cards = [...pd.querySelectorAll(".pd-card")];
    const contador = pd.querySelector(".pd-chip-fav b");
    const favs = new Set();

    // ---- piezas sueltas que usa el guion ----
    const dedo = (sel) => {
      const d = typeof sel === "string" ? pd.querySelector(sel) : sel;
      if (!d || !tap) return;
      const a = d.getBoundingClientRect(), b = mock.getBoundingClientRect();
      tap.style.left = (a.left - b.left + a.width / 2) + "px";
      tap.style.top = (a.top - b.top + a.height / 2) + "px";
      tap.classList.remove("toca"); void tap.offsetWidth; tap.classList.add("toca");
    };
    const marcarChip = (c) => chips.forEach((x) => x.classList.toggle("on", x.dataset.c === c));
    const mostrar = (fn) => cards.forEach((c, i) => c.classList.toggle("apagada", !fn(c, i)));
    const todas = () => mostrar(() => true);
    const escribir = (txt) => {
      let k = 0;
      escrito.textContent = "";
      const id = setInterval(() => {
        escrito.textContent = txt.slice(0, ++k);
        if (k >= txt.length) clearInterval(id);
      }, 110);
      relojes.push(id);
    };
    const corazon = (i, on) => {
      cards[i].classList.toggle("fav", on);
      if (on) favs.add(i); else favs.delete(i);
      contador.textContent = String(favs.size);
      pd.querySelector(".pd-chip-fav").classList.toggle("con-favs", favs.size > 0);
    };

    // ---- guion de cada paso: [milisegundos, qué hacer] ----
    const GUION = [
      [ // Filtrar: salsa, luego bachata, y vuelta a empezar
        [0,    () => { marcarChip("todo"); todas(); }],
        [700,  () => dedo('[data-c="salsa"]')],
        [1250, () => { marcarChip("salsa"); mostrar((c) => c.dataset.e === "salsa"); }],
        [3000, () => dedo('[data-c="bachata"]')],
        [3550, () => { marcarChip("bachata"); mostrar((c) => c.dataset.e === "bachata"); }],
        [5600, null],
      ],
      [ // Buscar: primero un profesor, luego una categoría
        [0,    () => { marcarChip("todo"); todas(); escrito.textContent = ""; }],
        [500,  () => dedo(".pd-search")],
        [900,  () => escribir(busca.dataset.b1)],
        [1800, () => mostrar((c) => c.dataset.b === "maykel")],
        [3600, () => { escrito.textContent = ""; todas(); }],
        [3900, () => escribir(busca.dataset.b2)],
        [5000, () => mostrar((c) => c.dataset.b === "solistas")],
        [6800, null],
      ],
      [ // Favoritos: marcar dos y luego filtrar por ellos
        [0,    () => { marcarChip("todo"); todas(); favs.clear(); cards.forEach((c) => c.classList.remove("fav")); contador.textContent = "0"; pd.querySelector(".pd-chip-fav").classList.remove("con-favs"); }],
        [600,  () => dedo(".pd-c0 .pd-heart")],
        [1050, () => corazon(0, true)],
        [1900, () => dedo(".pd-c3 .pd-heart")],
        [2350, () => corazon(3, true)],
        [3300, () => dedo('[data-c="fav"]')],
        [3800, () => { marcarChip("fav"); mostrar((c, i) => favs.has(i)); }],
        [6000, null],
      ],
      [ // Las cuatro salas: sin secuencia, se enseña el cuadrante
        [0, () => { marcarChip("todo"); todas(); escrito.textContent = ""; }],
      ],
    ];

    let relojes = [];
    const pararGuion = () => { relojes.forEach(clearTimeout); relojes.forEach(clearInterval); relojes = []; };
    const lanzarGuion = (i) => {
      pararGuion();
      const g = GUION[i];
      if (!g) return;
      g.forEach(([ms, fn]) => {
        relojes.push(setTimeout(() => {
          if (fn) fn();
          else lanzarGuion(i); // último paso sin acción: vuelve a empezar
        }, ms));
      });
    };

    const set = (i) => {
      i = Math.max(0, Math.min(total - 1, i));
      if (i === paso) return;
      paso = i;
      pd.dataset.step = String(i);
      pd.querySelectorAll(".pd-step").forEach((s, k) => s.classList.toggle("on", k === i));
      pd.querySelectorAll(".pd-dot").forEach((d, k) => d.classList.toggle("on", k === i));
      lanzarGuion(i);
    };

    // En pantalla ancha manda el scroll, como en la referencia.
    const porScroll = () => {
      const r = scroll.getBoundingClientRect();
      const recorrido = r.height - window.innerHeight;
      if (recorrido <= 0) return;
      const p = Math.min(1, Math.max(0, -r.top / recorrido));
      set(Math.floor(p * total * 0.999));
    };

    // En móvil (o si se pide menos movimiento) va solo, en bucle.
    let reloj = null;
    const auto = () => { reloj = setInterval(() => set((paso + 1) % total), 3800); };
    const parar = () => { if (reloj) { clearInterval(reloj); reloj = null; } };

    // La columna de pasos cambia de alto según lo largo que sea el párrafo
    // abierto, y como todo va centrado eso movía el título en cada cambio. Se le
    // reserva el alto del párrafo más largo y deja de bailar.
    const columna = pd.querySelector(".pd-steps");
    const fijarAlto = () => {
      if (!columna) return;
      columna.style.minHeight = "";
      const cerrado = columna.scrollHeight - [...pd.querySelectorAll(".pd-step.on p")]
        .reduce((a, e) => a + e.scrollHeight + 6, 0);
      const mayor = Math.max(...[...pd.querySelectorAll(".pd-step p")].map((e) => e.scrollHeight));
      columna.style.minHeight = Math.round(cerrado + mayor + 6) + "px";
    };

    const montar = () => {
      parar();
      window.removeEventListener("scroll", porScroll);
      if (ancho.matches && !reduce.matches) { window.addEventListener("scroll", porScroll, { passive: true }); porScroll(); }
      else { set(0); auto(); }
    };
    montar();
    fijarAlto();
    window.addEventListener("resize", fijarAlto);
    if (document.fonts && document.fonts.ready) document.fonts.ready.then(fijarAlto);
    ancho.addEventListener("change", () => { montar(); fijarAlto(); });
    reduce.addEventListener("change", montar);
    // Pulsar un paso: en móvil lo activa y detiene el bucle; en escritorio manda
    // el scroll, así que hay que llevar la página al punto de ese paso o el
    // siguiente movimiento lo desharía.
    pd.querySelectorAll(".pd-step").forEach((s, i) => s.addEventListener("click", () => {
      if (ancho.matches && !reduce.matches) {
        const r = scroll.getBoundingClientRect();
        const recorrido = r.height - window.innerHeight;
        const destino = scroll.offsetTop + recorrido * ((i + 0.5) / total);
        window.scrollTo({ top: destino, behavior: "smooth" });
      } else { parar(); set(i); }
    }));
    set(0);
  }
</script>

<style>
  .pd { background: var(--p-bg, #fff); --pd-aire: clamp(28px, 3.6vw, 50px); }
  /* Mismo aire arriba y abajo del título: los dos salen de --pd-aire, así que
     no pueden descuadrarse. El h2 va sin margen propio. */
  .pd-head { text-align: center; padding: 0 0 var(--pd-aire); }
  .pd-head h2 { margin: 0; }

  .pd-sticky { padding: var(--pd-aire) 0 clamp(34px, 4.5vw, 56px); }
  .pd-grid { display: grid; grid-template-columns: 1fr; gap: 28px; }

  /* Puntos de progreso */
  .pd-dots { display: flex; gap: 7px; justify-content: center; }
  .pd-dot { width: 7px; height: 7px; border-radius: 999px; background: #ddd8cf; transition: all .3s ease; }
  .pd-dot.on { background: #14121a; width: 22px; }

  /* ---- Maqueta ---- */
  .pd-mock {
    /* El dedo se posiciona dentro de esta caja: sin relative se anclaba a un
       ancestro lejano y en tablet acababa a 2.000px de donde debía. */
    position: relative;
    border-radius: 18px; border: 1px solid #ece8e1; background: #fff;
    box-shadow: 0 18px 44px rgba(20, 18, 26, .08); padding: 16px; overflow: hidden;
  }
  .pd-search {
    position: relative; display: flex; align-items: center;
    height: 38px; padding: 0 14px; border-radius: 999px; border: 1px solid #e6e1d8;
    font-size: 13px; color: #8d8898; overflow: hidden;
  }
  .pd-search strong { font-weight: 600; color: #14121a; display: none; white-space: pre; }
  /* Dedo que se desplaza hasta lo que se está pulsando */
  .pd-tap {
    position: absolute; z-index: 5; width: 22px; height: 22px; margin: -11px 0 0 -11px;
    border-radius: 50%; background: rgba(20, 18, 26, .14); border: 1.5px solid rgba(20, 18, 26, .35);
    opacity: 0; pointer-events: none;
    transition: left .55s cubic-bezier(.4, 0, .2, 1), top .55s cubic-bezier(.4, 0, .2, 1), opacity .3s ease;
  }
  .pd-tap.toca { animation: pdToca 1.1s ease forwards; }
  @keyframes pdToca {
    0% { opacity: 0; transform: scale(1.5); }
    35% { opacity: 1; transform: scale(1); }
    55% { transform: scale(.62); background: rgba(204, 153, 51, .45); border-color: var(--gold); }
    75% { transform: scale(1); }
    100% { opacity: 0; transform: scale(1); }
  }
  @media (prefers-reduced-motion: reduce) { .pd-tap { display: none; } }
  .pd-search .pd-cursor { display: none; width: 1.5px; height: 15px; background: var(--gold); margin-right: 1px; animation: pdBlink 1s steps(2) infinite; }
  @keyframes pdBlink { 50% { opacity: 0; } }
  .pd[data-step="1"] .pd-search em { display: none; }
  .pd[data-step="1"] .pd-search strong, .pd[data-step="1"] .pd-search .pd-cursor { display: inline-block; }
  .pd-search .pd-cursor { margin-left: 1px; margin-right: 0; }

  .pd-chips { display: flex; gap: 6px; margin-top: 11px; flex-wrap: wrap; }
  .pd-chip {
    padding: 6px 12px; border-radius: 999px; border: 1px solid #e6e1d8; background: #fff;
    font-size: 11.5px; font-weight: 700; color: #4a4a55; transition: all .35s ease;
  }
  .pd-chip.on { background: var(--gold); border-color: var(--gold); color: #fff; }
  .pd-chip-fav { display: inline-flex; align-items: center; gap: 6px; }
  .pd-chip-fav i { width: 9px; height: 9px; border-radius: 999px; background: #d7d2c8; }
  .pd-chip-fav b { padding: 1px 6px; border-radius: 999px; background: #ddd8cf; color: #fff; font-size: 10px; transition: background .35s ease; }
  .pd-chip-fav.con-favs i { background: #e0435f; }
  .pd-chip-fav.con-favs b { background: #e0435f; }
  .pd-chip-fav.on { background: #fdeef0; border-color: #f3c6ce; color: #c8324c; }
  .pd-chip-fav.on i, .pd-chip-fav.on b { background: #c8324c; }

  .pd-days { display: flex; gap: 14px; margin-top: 13px; padding-bottom: 9px; border-bottom: 1px solid #f0ece4; }
  .pd-day { font-size: 12px; font-weight: 700; color: #b8b3a8; }
  .pd-day.on { color: #14121a; box-shadow: 0 10px 0 -8px var(--gold); }
  /* Siempre ocupa su sitio aunque no se vea: si aparece y desaparece, la caja
     pega un salto de 31px al llegar al paso de las salas. */
  .pd-rooms { display: flex; gap: 6px; margin-top: 13px; visibility: hidden; opacity: 0; transition: opacity .35s ease; }
  .pd-room {
    flex: 1; padding: 5px 8px; border-radius: 7px; background: #f7f4ee;
    font-size: 9.5px; font-weight: 800; text-transform: uppercase; letter-spacing: .05em; color: #6a6a74;
    white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
  }
  .pd[data-step="3"] .pd-rooms { visibility: visible; opacity: 1; }

  /* Dos filas reservadas siempre: en el paso de las cuatro salas sólo se llena
     una, pero sin esto la caja encogía 106px y daba un salto. */
  /* Altura fija: con dos filas reservadas y alto propio, la caja no se mueve
     aunque en el paso de las cuatro salas los títulos ocupen más líneas. */
  .pd-cards { display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; gap: 9px; margin-top: 13px; height: 190px; }
  .pd-card {
    position: relative; padding: 11px 12px;
    border-radius: 12px; border: 1.5px solid #ece8e1; background: #fff;
    display: flex; flex-direction: column; gap: 4px;
    /* Sin esto, una palabra larga desborda la columna en la rejilla de 4 salas */
    min-width: 0; overflow: hidden; overflow-wrap: anywhere;
    transition: opacity .4s ease, transform .4s ease, border-color .4s ease;
  }
  .pd-card-t { font-size: 12px; font-weight: 700; line-height: 1.3; color: #14121a; }
  .pd-card-p { font-size: 11px; color: #6a6a74; }
  .pd-heart { position: absolute; right: 9px; bottom: 8px; color: #d7d2c8; transition: color .4s ease, transform .4s ease; }
  .pd-heart svg { display: block; fill: currentColor; }
  .e-mundial { border-color: #e2c27a; background: linear-gradient(135deg, #faeec6 0%, #e8cd86 100%); }
  .e-mundial .pd-card-t { color: #241d08; }

  /* Lo que el filtro o la búsqueda dejan fuera */
  .pd-card.apagada { opacity: .18; transform: scale(.96); }
  /* Corazón marcado */
  .pd-card.fav .pd-heart { color: #e0435f; animation: pdLate .5s ease both; }
  @keyframes pdLate { 0% { transform: scale(1); } 45% { transform: scale(1.5); } 100% { transform: scale(1.12); } }
  /* Paso 4: las cuatro salas, una columna cada una */
  .pd[data-step="3"] .pd-cards { grid-template-columns: repeat(4, 1fr); }
  .pd[data-step="3"] .r-gs { order: 1; } .pd[data-step="3"] .r-pb { order: 2; }
  .pd[data-step="3"] .r-s1 { order: 3; } .pd[data-step="3"] .r-s2 { order: 4; }
  .pd[data-step="3"] .pd-card-t { font-size: 11px; }
  .pd[data-step="3"] .pd-cards { gap: 5px; }
  @media (max-width: 620px) {
    .pd[data-step="3"] .pd-card { padding: 8px 7px; min-height: 76px; }
    .pd[data-step="3"] .pd-card-t { font-size: 9.5px; }
    .pd[data-step="3"] .pd-card-p { font-size: 9px; }
    .pd[data-step="3"] .pd-heart { display: none; }
  }

  /* ---- Pasos ---- */
  .pd-step { padding: 7px 0; cursor: pointer; }
  .pd-step h3 { margin: 0; font-size: clamp(22px, 3.6vw, 34px); font-weight: 500; letter-spacing: -.015em; color: #c9c4bb; transition: color .3s ease; }
  .pd-step p { margin: 0; max-height: 0; overflow: hidden; opacity: 0; font-size: 15px; line-height: 1.6; color: #4a4a55; transition: all .35s ease; }
  .pd-step.on h3 { color: #14121a; }
  .pd-step.on p { max-height: 160px; opacity: 1; margin-top: 6px; }
