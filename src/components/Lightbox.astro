---
const { lang = "es" } = Astro.props;
const IG = "https://www.instagram.com/lanegraworldchampionship/";
const ARROBA = "@lanegraworldchampionship";
const L = {
  es: { close: "Cerrar", prev: "Anterior", next: "Siguiente",
        bajar: "Descargar imagen", bajando: "Preparando…",
        pide: "Etiquétanos al subirla y podremos publicitarte:",
        gracias: "¡Ya es tuya! Etiquétanos al subirla y podremos publicitarte:",
        compartir: "Compartir", oBajar: "o descargar la imagen", copiar: "Copiar", copiado: "¡Copiado!", copiaFallo: "Cópialo a mano",
        textoCompartir: "Mundial de Pasos Libres 2026 · @lanegraworldchampionship",
        abrirIG: "Abrir Instagram", fallo: "Ábrela y guárdala con una pulsación larga." },
  en: { close: "Close", prev: "Previous", next: "Next",
        bajar: "Download image", bajando: "Getting it ready…",
        pide: "Tag us when you post it and we can give you a shout-out:",
        gracias: "It's yours! Tag us when you post it and we can give you a shout-out:",
        compartir: "Share", oBajar: "or download the image", copiar: "Copy", copiado: "Copied!", copiaFallo: "Copy it by hand",
        textoCompartir: "Pasos Libres World Championship 2026 · @lanegraworldchampionship",
        abrirIG: "Open Instagram", fallo: "Open it and save it with a long press." },
  it: { close: "Chiudi", prev: "Precedente", next: "Successiva",
        bajar: "Scarica immagine", bajando: "Un attimo…",
        pide: "Taggaci quando la pubblichi e potremo darti visibilità:",
        gracias: "È tua! Taggaci quando la pubblichi e potremo darti visibilità:",
        compartir: "Condividi", oBajar: "o scarica l'immagine", copiar: "Copia", copiado: "Copiato!", copiaFallo: "Copialo a mano",
        textoCompartir: "Mondiale di Pasos Libres 2026 · @lanegraworldchampionship",
        abrirIG: "Apri Instagram", fallo: "Aprila e salvala con una pressione lunga." },
}[lang] || {};
// Lightbox reutilizable: haz click en cualquier <img data-lightbox> para verla en grande.
// Navega entre todas las imágenes data-lightbox de la página con las flechas, el teclado
// (← →) o deslizando en móvil. Cierra con click fuera, botón ✕ o tecla Escape.
---
<div class="lightbox" data-lightbox-overlay hidden aria-hidden="true" data-textos={JSON.stringify(L)} data-arroba={ARROBA}>
  <button class="lightbox-close" type="button" aria-label={L.close}>&times;</button>
  <button class="lightbox-nav lightbox-prev" type="button" aria-label={L.prev}>&#8249;</button>
  <figure class="lightbox-fig">
    <img class="lightbox-img" alt="" />
    <figcaption class="lightbox-count" data-lightbox-count></figcaption>

    {/* Descarga + la petición de etiquetar. Es el circuito que trae gente de
        vuelta: lo que reparten lleva nuestro usuario delante. */}
    <div class="lb-bajar">
      <button type="button" class="lb-btn" data-lb-principal>{L.bajar}</button>
      <button type="button" class="lb-link" data-lb-otro hidden>{L.oBajar}</button>
      <p class="lb-pide" data-lb-pide>
        <span data-lb-pide-txt>{L.pide}</span>
        <a href={IG} target="_blank" rel="noopener">{ARROBA}</a>
        <button type="button" class="lb-copiar" data-lb-copiar>{L.copiar}</button>
      </p>
    </div>
  </figure>
  <button class="lightbox-nav lightbox-next" type="button" aria-label={L.next}>&#8250;</button>
</div>

<style>
  .lightbox {
    position: fixed; inset: 0; z-index: 4000;
    display: flex; align-items: center; justify-content: center;
    padding: clamp(16px, 4vw, 56px);
    background: rgba(10, 8, 20, .9);
    -webkit-backdrop-filter: blur(6px); backdrop-filter: blur(6px);
    opacity: 0; transition: opacity .25s ease;
  }
  .lightbox[hidden] { display: none; }
  .lightbox.open { opacity: 1; }
  .lightbox-fig { margin: 0; display: flex; flex-direction: column; align-items: center; }
  .lightbox-img {
    max-width: min(92vw, 1100px); max-height: 86vh;
    width: auto; height: auto; object-fit: contain;
    border-radius: 14px; box-shadow: 0 24px 70px rgba(0, 0, 0, .55);
    transform: scale(.95); transition: transform .28s cubic-bezier(.22, 1, .36, 1);
  }
  .lightbox.open .lightbox-img { transform: scale(1); }
  .lightbox-img.swap { animation: lb-swap .26s ease; }
  @keyframes lb-swap { from { opacity: .25; } to { opacity: 1; } }
  .lb-bajar { display: flex; flex-direction: column; align-items: center; gap: 8px; margin-top: 14px; }
  .lb-btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 10px 20px; border-radius: 999px; border: 0; cursor: pointer;
    background: var(--gold, #c9a227); color: #14121a;
    font-family: var(--font-body); font-size: 14.5px; font-weight: 800;
  }
  .lb-btn:hover { background: #e0b73a; }
  .lb-btn:disabled { opacity: .6; cursor: default; }
  .lb-pide { margin: 0; text-align: center; font-family: var(--font-body); font-size: 13.5px; color: rgba(255,255,255,.82); line-height: 1.45; max-width: 420px; }
  .lb-pide a { color: var(--gold, #c9a227); font-weight: 800; text-decoration: underline; text-underline-offset: 3px; }
  .lb-link {
    border: 0; background: none; padding: 2px 4px; cursor: pointer;
    font-family: var(--font-body); font-size: 13px; color: rgba(255,255,255,.7);
    text-decoration: underline; text-underline-offset: 3px;
  }
  .lb-link[hidden] { display: none; }
  .lb-link:hover { color: #fff; }
  .lb-copiar {
    margin-left: 6px; padding: 2px 9px; border-radius: 999px; cursor: pointer;
    border: 1px solid rgba(255,255,255,.35); background: transparent;
    font-family: var(--font-body); font-size: 11.5px; font-weight: 700; color: rgba(255,255,255,.85);
  }
  .lb-copiar:hover { border-color: var(--gold, #c9a227); color: var(--gold, #c9a227); }

  .lightbox-count {
    text-align: center; margin-top: 14px;
    color: rgba(255, 255, 255, .82); font-family: var(--font-body);
    font-size: 14px; letter-spacing: .05em;
  }
  .lightbox-close {
    position: absolute; top: 18px; right: 22px;
    width: 46px; height: 46px; border-radius: 50%;
    border: none; cursor: pointer;
    background: rgba(255, 255, 255, .14); color: #fff;
    font-size: 30px; line-height: 1;
    display: flex; align-items: center; justify-content: center;
    transition: background .2s;
  }
  .lightbox-close:hover { background: rgba(255, 255, 255, .3); }
  .lightbox-nav {
    position: absolute; top: 50%; transform: translateY(-50%);
    width: 52px; height: 52px; border-radius: 50%;
    border: none; cursor: pointer;
    background: rgba(255, 255, 255, .14); color: #fff;
    font-size: 34px; line-height: 1;
    display: flex; align-items: center; justify-content: center;
    transition: background .2s;
  }
  .lightbox-nav:hover { background: rgba(255, 255, 255, .3); }
  .lightbox-nav[hidden] { display: none; }
  .lightbox-prev { left: clamp(8px, 3vw, 34px); }
  .lightbox-next { right: clamp(8px, 3vw, 34px); }
  @media (max-width: 560px) {
    .lightbox-nav { width: 44px; height: 44px; font-size: 28px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .lightbox, .lightbox-img { transition: none; }
    .lightbox-img.swap { animation: none; }
  }
</style>

<script>
  const overlay = document.querySelector<HTMLElement>("[data-lightbox-overlay]");
  if (overlay) {
    const imgEl = overlay.querySelector<HTMLImageElement>(".lightbox-img");
    const countEl = overlay.querySelector<HTMLElement>("[data-lightbox-count]");
    const prevBtn = overlay.querySelector<HTMLButtonElement>(".lightbox-prev");
    const nextBtn = overlay.querySelector<HTMLButtonElement>(".lightbox-next");
    if (!imgEl || !countEl || !prevBtn || !nextBtn) throw new Error("Lightbox markup incomplete");

    let items: HTMLImageElement[] = [];
    let idx = 0;

    const render = () => {
      const t = items[idx];
      if (!t) return;
      imgEl.src = t.getAttribute("data-full") || t.currentSrc || t.src;
      imgEl.alt = t.alt || "";
      const multi = items.length > 1;
      countEl.textContent = multi ? `${idx + 1} / ${items.length}` : "";
      prevBtn.hidden = !multi;
      nextBtn.hidden = !multi;
      const pt = overlay.querySelector<HTMLElement>("[data-lb-pide-txt]");
      const T0 = JSON.parse(overlay.dataset.textos || "{}");
      if (pt && T0.pide) pt.textContent = T0.pide;
    };
    const open = (trigger: HTMLImageElement) => {
      items = [...document.querySelectorAll<HTMLImageElement>("img[data-lightbox]")];
      idx = Math.max(0, items.indexOf(trigger));
      overlay.hidden = false;
      overlay.setAttribute("aria-hidden", "false");
      render();
      requestAnimationFrame(() => overlay.classList.add("open"));
      document.body.style.overflow = "hidden";
    };
    const close = () => {
      overlay.classList.remove("open");
      overlay.setAttribute("aria-hidden", "true");
      document.body.style.overflow = "";
      setTimeout(() => { overlay.hidden = true; imgEl.removeAttribute("src"); }, 280);
    };
    const go = (dir: number) => {
      if (items.length < 2) return;
      idx = (idx + dir + items.length) % items.length;
      imgEl.classList.remove("swap");
      void imgEl.offsetWidth;
      imgEl.classList.add("swap");
      render();
    };

    // Compartir o descargar la imagen que se está viendo.
    const btnPrincipal = overlay.querySelector<HTMLButtonElement>("[data-lb-principal]");
    const btnOtro = overlay.querySelector<HTMLButtonElement>("[data-lb-otro]");
    const btnCopiar = overlay.querySelector<HTMLButtonElement>("[data-lb-copiar]");
    const pideTxt = overlay.querySelector<HTMLElement>("[data-lb-pide-txt]");
    const T = JSON.parse(overlay.dataset.textos || "{}");
    const ARROBA_TXT = overlay.dataset.arroba || "";

    // Compartir archivos solo existe en móvil. Donde no esté, el botón
    // principal descarga y no se ofrece la alternativa.
    const puedeCompartir = (() => {
      try {
        const f = new File([new Blob([""])], "x.webp", { type: "image/webp" });
        return !!(navigator.canShare && navigator.canShare({ files: [f] }));
      } catch { return false; }
    })();
    if (btnPrincipal) btnPrincipal.textContent = puedeCompartir ? T.compartir : T.bajar;
    if (btnOtro) btnOtro.hidden = !puedeCompartir;

    function nombreArchivo(url: string, alt: string) {
      const ext = (url.split("?")[0].split(".").pop() || "webp").slice(0, 5);
      const base = (alt || "la-negra-2026")
        .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
        .replace(/[^a-zA-Z0-9]+/g, "-").replace(/^-|-$/g, "").toLowerCase();
      return `${base || "la-negra-2026"}-la-negra-2026.${ext}`;
    }

    async function traerArchivo() {
      const url = imgEl.src;
      if (!url) return null;
      // cache: "reload" es imprescindible. La imagen ya está en la caché del
      // navegador de cuando se mostró con <img>, y esa copia NO guarda la
      // cabecera CORS: si se reutiliza, el fetch falla aunque el servidor la
      // mande. Esto obliga a pedirla de nuevo a la red.
      const r = await fetch(url, { cache: "reload" });
      if (!r.ok) throw new Error("no");
      const blob = await r.blob();
      return new File([blob], nombreArchivo(url, imgEl.alt), { type: blob.type || "image/webp" });
    }

    function guardar(file: File) {
      const a = document.createElement("a");
      a.href = URL.createObjectURL(file);
      a.download = file.name;
      document.body.appendChild(a); a.click(); a.remove();
      setTimeout(() => URL.revokeObjectURL(a.href), 4000);
    }

    async function accion(compartir: boolean, boton: HTMLButtonElement) {
      const antes = boton.textContent;
      boton.disabled = true;
      boton.textContent = T.bajando;
      try {
        const file = await traerArchivo();
        if (!file) return;
        if (compartir) {
          try {
            await navigator.share({ files: [file], text: T.textoCompartir });
          } catch (e: any) {
            // Si cancela el menú no es un fallo: no se hace nada más.
            if (e && e.name === "AbortError") { boton.disabled = false; boton.textContent = antes; return; }
            guardar(file);
          }
        } else {
          guardar(file);
        }
        if (pideTxt) pideTxt.textContent = T.gracias;
      } catch {
        window.open(imgEl.src, "_blank", "noopener");
        if (pideTxt) pideTxt.textContent = T.fallo + " " + T.pide;
      }
      boton.disabled = false;
      boton.textContent = antes;
    }

    btnPrincipal?.addEventListener("click", (e) => { e.stopPropagation(); accion(puedeCompartir, btnPrincipal); });
    btnOtro?.addEventListener("click", (e) => { e.stopPropagation(); accion(false, btnOtro); });

    // Copiar el usuario: Instagram no deja rellenar el texto desde fuera, así
    // que lo más que se puede hacer es dejarlo listo para pegar.
    btnCopiar?.addEventListener("click", async (e) => {
      e.stopPropagation();
      let ok = false;
      try {
        await navigator.clipboard.writeText(ARROBA_TXT);
        ok = true;
      } catch {
        // El portapapeles moderno falla en algunos navegadores y dentro de
        // apps embebidas (el navegador de Instagram, sin ir más lejos).
        try {
          const ta = document.createElement("textarea");
          ta.value = ARROBA_TXT;
          ta.setAttribute("readonly", "");
          ta.style.cssText = "position:fixed;top:-100px;opacity:0";
          document.body.appendChild(ta);
          ta.select();
          ok = document.execCommand("copy");
          ta.remove();
        } catch { ok = false; }
      }
      const antes = btnCopiar.textContent;
      btnCopiar.textContent = ok ? T.copiado : T.copiaFallo;
      setTimeout(() => { btnCopiar.textContent = antes; }, 1800);
    });

    document.addEventListener("click", (e) => {
      const target = e.target as Element | null;
      if (!target?.closest) return;
      const trigger = target.closest("img[data-lightbox]") as HTMLImageElement | null;
      if (trigger) { e.preventDefault(); open(trigger); return; }
      if (overlay.hidden) return;
      if (target.closest(".lightbox-prev")) { e.stopPropagation(); go(-1); return; }
      if (target.closest(".lightbox-next")) { e.stopPropagation(); go(1); return; }
      if (target === overlay || target.closest(".lightbox-close")) close();
    });
    document.addEventListener("keydown", (e) => {
      if (overlay.hidden) {
        if (e.key === "Enter" || e.key === " ") {
          const t = document.activeElement;
          if (t instanceof HTMLImageElement && t.matches("img[data-lightbox]")) {
            e.preventDefault();
            open(t);
          }
        }
        return;
      }
      if (e.key === "Escape") close();
      else if (e.key === "ArrowLeft") go(-1);
      else if (e.key === "ArrowRight") go(1);
    });

    // Deslizar en móvil para navegar
    let sx = 0;
    overlay.addEventListener("touchstart", (e) => { sx = e.touches[0].clientX; }, { passive: true });
    overlay.addEventListener("touchend", (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      if (Math.abs(dx) > 50) go(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
</script>
