---
// Página de directos: una pantalla por competición (las once del Mundial), y
// cada una se enciende sola cuando esa competición sale al escenario.
//
// El horario sale de directos-horario.js, que lo deriva de la PARRILLA de
// emisión (el plan de producción), no de programa.js: solo se emiten tres
// jornadas y algunos horarios no coinciden con los del festival.
//
// Aquí solo se ordena y se pinta. El "qué hay ahora" se resuelve en el
// navegador, porque la página es estática: se recalcula cada 30 s.
import { COMPETICIONES, NOMBRES_COMP, ZONA, I18N } from "@/data/directos.js";
import { horarioPorCompeticion } from "@/data/directos-horario.js";

const { lang = "es" } = Astro.props;
const t = I18N[lang] || I18N.es;
const nombres = NOMBRES_COMP[lang] || NOMBRES_COMP.es;
const RUTA_PROGRAMA = { es: "/programacion-2026/", en: "/en/programme-2026/", it: "/it/programma-2026/" }[lang];

const porComp = horarioPorCompeticion(lang);

// De antes a después: manda cuándo empieza cada competición, no la disciplina.
// Es el orden con el que se publica la página; luego, en el navegador, lo que
// esté en directo sube al principio.
const momento = (s) => s.dia * 1440 + s.ini;
const pantallas = COMPETICIONES.map((c) => ({
  clave: c.clave,
  nombre: nombres[c.clave] || c.clave,
  portada: c.portada,
  disciplina: c.disciplina,
  sesiones: porComp[c.clave],
})).sort((a, b) => momento(a.sesiones[0]) - momento(b.sesiones[0]));

const DATOS = {
  zona: ZONA,
  comps: pantallas.map((p) => ({ clave: p.clave, sesiones: p.sesiones })),
  textos: {
    directo: t.directo, luego: t.luego, sinEnlace: t.sinEnlace,
    proximo: t.proximo, terminada: t.terminada,
    ningunaActiva: t.ningunaActiva, antesDelFestival: t.antesDelFestival,
    despuesDelFestival: t.despuesDelFestival,
    una: t.activas(1), varias: t.activas(2).replace(/^2\s*/, ""),
  },
};
---

<div class="prop">
  <section class="p-section p-tight dir-top">
    <div class="p-container">
      <p class="p-eyebrow">{t.eyebrow}</p>
      <h1 class="p-display dir-h1">
        <span class="dir-rec" aria-hidden="true"></span>{t.h1}
      </h1>
      <p class="p-lead p-narrow">{t.lead}</p>
      <p class="dir-estado" data-dir-estado role="status" aria-live="polite">{t.cargando}</p>
      <p class="dir-zona">{t.jornadas} · {t.horaLocal}</p>
    </div>
  </section>

  <section class="p-section p-tight">
    <div class="p-container">
      <div class="dir-grid" data-dir-grid>
        {pantallas.map((p) => (
          <article class="dir-pantalla" data-comp={p.clave} data-disc={p.disciplina}>
            <div class="dir-marco">
              {p.portada
                ? <img class="dir-cartel" src={p.portada} alt="" loading="lazy" decoding="async" />
                : <div class="dir-cartel dir-cartel-vacio"><span>{p.nombre}</span></div>}
              <div class="dir-capa">
                <button class="dir-play" type="button" data-dir-play hidden>
                  <span class="dir-play-icono" aria-hidden="true"></span>
                  <span class="dir-play-txt">{t.verAhora}</span>
                </button>
                <p class="dir-nota" data-dir-nota>{t.sinEmision}</p>
              </div>
              <div class="dir-reproductor" data-dir-reproductor hidden></div>
            </div>
            <div class="dir-pie">
              <div class="dir-pie-cab">
                <h2 class="dir-comp">{p.nombre}</h2>
                <span class="dir-badge" data-dir-badge hidden>
                  <span class="dir-badge-punto" aria-hidden="true"></span>{t.directo}
                </span>
              </div>
              <p class="dir-sesion" data-dir-sesion></p>
              {/* El calendario completo de la competición. Va en el HTML, no lo
                  pinta el JS: así se lee aunque el script no llegue a correr, y
                  los buscadores ven los horarios. */}
              <ul class="dir-horas">
                {p.sesiones.map((s, i) => (
                  <li class="dir-hora" data-i={i}>
                    <span class="dir-hora-dia">{s.etiqueta}</span>
                    <span class="dir-hora-h">{s.hora}</span>
                    <span class="dir-hora-n">{s.n}</span>
                  </li>
                ))}
              </ul>
            </div>
          </article>
        ))}
      </div>

      <p class="dir-aviso">{t.avisoDatos}</p>
      <p class="dir-acciones"><a class="p-btn p-btn-dark" href={RUTA_PROGRAMA}>{t.verPrograma}</a></p>
    </div>
  </section>
</div>

<script type="application/json" id="dir-datos" set:html={JSON.stringify(DATOS)} is:inline />

<script>
  (function () {
    const nodo = document.getElementById("dir-datos");
    if (!nodo) return;
    const D = JSON.parse(nodo.textContent || "{}");
    const T = D.textos || {};
    // Cada pase trae ya calculados `desde` y `hasta` en milisegundos UTC, con
    // el cambio de hora del domingo 25 resuelto en el build. Aquí basta con
    // comparar relojes: no hace falta saber nada de husos.
    const comps = D.comps || [];

    function estado() {
      const t = Date.now();
      const out = {};
      let activas = 0;

      comps.forEach((c) => {
        let viva = null, vivaI = -1, sig = null, sigI = -1;
        const pasadas = [];

        c.sesiones.forEach((s, i) => {
          if (t >= s.desde && t < s.hasta) { viva = s; vivaI = i; }
          else if (t < s.desde) { if (!sig || s.desde < sig.desde) { sig = s; sigI = i; } }
          else pasadas.push(i);
        });

        if (viva) { out[c.clave] = { tipo: "directo", s: viva, i: vivaI, pasadas, orden: viva.desde }; activas++; }
        else if (sig) out[c.clave] = { tipo: "proxima", s: sig, i: sigI, pasadas, orden: sig.desde };
        else out[c.clave] = { tipo: "terminada", pasadas, orden: Infinity };
      });

      return { out, activas, ahora: t };
    }

    // ── Pintado ──────────────────────────────────────────────────────────
    const rejilla = document.querySelector("[data-dir-grid]");
    const pantallas = Array.prototype.slice.call(document.querySelectorAll(".dir-pantalla"));
    const elEstado = document.querySelector("[data-dir-estado]");
    const orden = {};
    pantallas.forEach((p, i) => { orden[p.getAttribute("data-comp")] = i; });

    function limpiarReproductor(p) {
      const caja = p.querySelector("[data-dir-reproductor]");
      if (caja && caja.firstChild) { caja.innerHTML = ""; caja.hidden = true; }
      p.classList.remove("reproduciendo");
    }

    function abrir(p) {
      const em = p._emision;
      if (!em || !em.fuente) return;
      // Solo una competición sonando a la vez: varios directos simultáneos
      // saturan la conexión y además se pisan los audios.
      pantallas.forEach((o) => { if (o !== p) limpiarReproductor(o); });

      const caja = p.querySelector("[data-dir-reproductor]");
      const src = em.tipo === "vimeo"
        ? "https://player.vimeo.com/video/" + encodeURIComponent(em.fuente) + "?autoplay=1"
        : em.tipo === "youtube"
        ? "https://www.youtube-nocookie.com/embed/" + encodeURIComponent(em.fuente) + "?autoplay=1&rel=0"
        : em.fuente;
      const marco = document.createElement("iframe");
      marco.src = src;
      marco.title = (p.querySelector(".dir-comp") || {}).textContent || "";
      marco.setAttribute("allow", "autoplay; fullscreen; picture-in-picture");
      marco.setAttribute("allowfullscreen", "");
      marco.setAttribute("loading", "lazy");
      caja.appendChild(marco);
      caja.hidden = false;
      p.classList.add("reproduciendo");
    }

    function hhmm(min) {
      return String(Math.floor(min / 60) % 24).padStart(2, "0") + ":" + String(min % 60).padStart(2, "0");
    }

    function pintar() {
      const { out, activas, ahora } = estado();

      pantallas.forEach((p) => {
        const clave = p.getAttribute("data-comp");
        const info = out[clave] || { tipo: "terminada", pasadas: [] };
        const badge = p.querySelector("[data-dir-badge]");
        const sesion = p.querySelector("[data-dir-sesion]");
        const nota = p.querySelector("[data-dir-nota]");
        const play = p.querySelector("[data-dir-play]");
        const enDirecto = info.tipo === "directo";

        p.classList.toggle("activa", enDirecto);
        p.classList.toggle("terminada", info.tipo === "terminada");
        badge.hidden = !enDirecto;

        // Las horas: tachada la que ya pasó, resaltada la de ahora o la que viene.
        const horas = p.querySelectorAll(".dir-hora");
        Array.prototype.forEach.call(horas, function (li, i) {
          li.classList.toggle("pasada", info.pasadas.indexOf(i) !== -1);
          li.classList.toggle("ahora", enDirecto && i === info.i);
          li.classList.toggle("siguiente", info.tipo === "proxima" && i === info.i);
        });

        if (enDirecto) {
          // La cámara está en la sala, así que el enlace sale de la sala en la
          // que compite ahora mismo.
          const em = info.s.emision || null;
          p._emision = em;
          sesion.textContent = info.s.hora + " · " + info.s.n;
          if (em) { play.hidden = false; nota.hidden = true; }
          else { play.hidden = true; nota.hidden = false; nota.textContent = T.sinEnlace; }
        } else {
          limpiarReproductor(p);
          p._emision = null;
          play.hidden = true;
          nota.hidden = false;
          if (info.tipo === "proxima") {
            sesion.textContent = T.luego + " · " + info.s.etiqueta + " " + info.s.hora;
            nota.textContent = info.s.etiqueta + " · " + T.proximo + " " + info.s.horaIni;
          } else {
            sesion.textContent = "";
            nota.textContent = T.terminada;
          }
        }
      });

      // De antes a después: primero lo que está en directo, luego lo que viene
      // por orden de hora, y al final lo que ya ha terminado.
      pantallas.slice()
        .sort(function (a, b) {
          const oa = (out[a.getAttribute("data-comp")] || {}).orden;
          const ob = (out[b.getAttribute("data-comp")] || {}).orden;
          return (oa === ob ? 0 : oa < ob ? -1 : 1) ||
                 orden[a.getAttribute("data-comp")] - orden[b.getAttribute("data-comp")];
        })
        .forEach(function (p, i) { p.style.order = String(i); });

      if (elEstado) {
        const todos = comps.reduce(function (a, c) { return a.concat(c.sesiones); }, []);
        const primera = Math.min.apply(null, todos.map(function (s) { return s.desde; }));
        const ultima = Math.max.apply(null, todos.map(function (s) { return s.hasta; }));
        elEstado.textContent = activas > 0
          ? (activas === 1 ? T.una : activas + " " + T.varias)
          : ahora < primera ? T.antesDelFestival
          : ahora >= ultima ? T.despuesDelFestival
          : T.ningunaActiva;
        elEstado.classList.toggle("hay-directo", activas > 0);
      }
    }

    pantallas.forEach((p) => {
      const b = p.querySelector("[data-dir-play]");
      if (b) b.addEventListener("click", function () { abrir(p); });
    });

    pintar();
    setInterval(pintar, 30000);
    document.addEventListener("visibilitychange", function () {
      if (!document.hidden) pintar();
    });
  })();
</script>

<style>
  /* `display` gana al atributo `hidden`, y aquí hay varios inline-flex que lo
     pisaban: sin esto salían a la vez el botón, el aviso y el rótulo rojo. */
  .dir-pantalla [hidden] { display: none !important; }

  .dir-top { padding-top: 20px; }
  .dir-h1 { display: flex; align-items: center; gap: 18px; }
  .dir-rec {
    width: .42em; height: .42em; border-radius: 50%; background: #e02020;
    flex: 0 0 auto; box-shadow: 0 0 0 0 rgba(224, 32, 32, .55);
    animation: dir-latido 1.6s ease-out infinite;
  }
  @keyframes dir-latido {
    0%   { box-shadow: 0 0 0 0 rgba(224, 32, 32, .55); opacity: 1; }
    70%  { box-shadow: 0 0 0 .55em rgba(224, 32, 32, 0); opacity: .75; }
    100% { box-shadow: 0 0 0 0 rgba(224, 32, 32, 0); opacity: 1; }
  }

  .dir-estado { margin: 26px 0 0; font-weight: 700; font-size: 17px; color: var(--p-muted); }
  .dir-estado.hay-directo { color: #c21818; }
  .dir-zona { margin: 4px 0 0; font-size: 14px; color: var(--p-muted); }

  .dir-grid { display: grid; gap: 24px; grid-template-columns: repeat(auto-fit, minmax(310px, 1fr)); }

  .dir-pantalla {
    border: 1px solid var(--p-line); border-radius: var(--p-radius);
    overflow: hidden; background: #fff; min-width: 0;
    transition: border-color .2s ease, box-shadow .2s ease, opacity .2s ease;
  }
  .dir-pantalla.activa { border-color: #e02020; box-shadow: 0 0 0 1px #e02020; }
  .dir-pantalla.terminada { opacity: .58; }

  .dir-marco { position: relative; aspect-ratio: 16 / 9; background: #0f0b1e; }
  .dir-cartel {
    position: absolute; inset: 0; width: 100%; height: 100%;
    object-fit: cover; opacity: .38; max-width: 100%;
  }
  /* Mientras no haya portada del diseñador, un fondo con el nombre. Cambia de
     tono según la disciplina, para distinguirlas de un vistazo. */
  /* Provisional hasta que lleguen las portadas del diseñador: el nombre va
     arriba, no centrado, para no pisarse con el aviso del centro. */
  .dir-cartel-vacio {
    display: flex; align-items: flex-start; justify-content: flex-start;
    padding: 18px 20px; opacity: 1;
  }
  .dir-cartel-vacio span {
    font-weight: 800; font-size: 12px; line-height: 1.3; text-transform: uppercase;
    letter-spacing: .12em; color: rgba(255,255,255,.34);
  }
  [data-disc="bachata"] .dir-cartel-vacio { background: linear-gradient(140deg, #2a1536 0%, #0f0b1e 68%); }
  [data-disc="salsa"] .dir-cartel-vacio { background: linear-gradient(140deg, #16263f 0%, #0f0b1e 68%); }
  .dir-pantalla.activa .dir-cartel { opacity: .52; }

  .dir-capa {
    position: absolute; inset: 0; display: flex; flex-direction: column;
    align-items: center; justify-content: center; gap: 12px; padding: 20px; text-align: center;
  }
  .dir-nota {
    margin: 0; color: rgba(255,255,255,.85); font-size: 14px; max-width: 30ch;
    background: rgba(15,11,30,.55); border-radius: 999px; padding: 5px 14px;
  }

  .dir-play {
    display: inline-flex; align-items: center; gap: 12px; cursor: pointer;
    border: 0; border-radius: 999px; padding: 13px 26px 13px 20px;
    background: #fff; color: var(--p-ink); font: inherit; font-weight: 700; font-size: 15px;
    transition: transform .15s ease;
  }
  .dir-play:hover { transform: translateY(-2px); }
  .dir-play-icono {
    width: 0; height: 0; border-left: 13px solid var(--p-ink);
    border-top: 8px solid transparent; border-bottom: 8px solid transparent;
  }

  .dir-reproductor { position: absolute; inset: 0; background: #000; }
  .dir-reproductor :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .dir-pantalla.reproduciendo .dir-capa { display: none; }

  .dir-pie { padding: 17px 20px 19px; }
  .dir-pie-cab {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 12px;
  }
  .dir-comp { margin: 0; font-size: 17.5px; font-weight: 700; letter-spacing: -.012em; line-height: 1.25; min-width: 0; }
  .dir-sesion { margin: 5px 0 0; font-size: 14px; color: var(--p-muted); line-height: 1.45; }
  .dir-sesion:empty { display: none; }

  /* Calendario de la competición: una línea por pase, con su día, su hora y
     su sala. Lo que ya pasó se atenúa; lo de ahora se marca en rojo. */
  .dir-horas {
    list-style: none; margin: 13px 0 0; padding: 13px 0 0;
    border-top: 1px solid var(--p-line);
    display: flex; flex-direction: column; gap: 2px;
  }
  .dir-hora {
    display: grid; grid-template-columns: 4.6em 8.4em 1fr; gap: 8px;
    font-size: 13px; line-height: 1.7; color: var(--p-muted);
    font-variant-numeric: tabular-nums;
  }
  .dir-hora-dia { font-weight: 700; color: var(--p-ink); opacity: .72; }
  .dir-hora-n { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .dir-hora.pasada { opacity: .42; }
  .dir-hora.pasada .dir-hora-h { text-decoration: line-through; }
  .dir-hora.ahora { color: #c21818; font-weight: 700; }
  .dir-hora.ahora .dir-hora-dia { color: #c21818; opacity: 1; }
  .dir-hora.siguiente { color: var(--p-ink); font-weight: 700; }
  .dir-hora.siguiente .dir-hora-dia { opacity: 1; }

  .dir-badge {
    display: inline-flex; align-items: center; gap: 7px; flex: 0 0 auto;
    background: #e02020; color: #fff; border-radius: 999px;
    padding: 5px 13px 5px 11px; font-size: 12px; font-weight: 800; letter-spacing: .06em;
  }
  .dir-badge-punto {
    width: 7px; height: 7px; border-radius: 50%; background: #fff;
    animation: dir-parpadeo 1.3s steps(1, end) infinite;
  }
  @keyframes dir-parpadeo { 0%, 55% { opacity: 1; } 56%, 100% { opacity: .25; } }

  .dir-aviso { margin: 28px 0 0; font-size: 14px; color: var(--p-muted); }
  .dir-acciones { margin: 22px 0 0; }

  /* Quien pide menos animación no ve parpadeos: el punto se queda fijo. */
  @media (prefers-reduced-motion: reduce) {
    .dir-rec, .dir-badge-punto { animation: none; }
  }

  @media (max-width: 560px) {
    .dir-grid { grid-template-columns: 1fr; gap: 18px; }
    .dir-h1 { gap: 12px; }
  }
</style>
