---
import Base from "@/layouts/Base.astro";
---
<Base noindex title="Page not found — La Negra Dance Festival" lang="en">
  <section class="notfound text-center">
    <div class="container">
      <p class="code">404</p>
      <h1 class="script-title">Page not found</h1>
      <p class="msg">The page you are looking for doesn't exist or has moved.</p>
      <div class="actions">
        <a class="btn btn-solid" href="/en/">Back to the homepage</a>
        <a class="btn btn-outline" href="/en/programme-2026/">2026 schedule</a>
        <a class="btn btn-outline" href="/en/contact/">Contact</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { padding: 110px 0 120px; }
  .code { font-family: var(--font-script); color: var(--gold); font-size: clamp(90px, 20vw, 180px); line-height: 1; margin: 0; }
  .script-title { margin-top: 6px; }
  .msg { color: var(--text); font-size: 18px; margin: 6px 0 28px; }
  .actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
</style>
