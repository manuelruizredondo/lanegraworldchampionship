---
import Base from "@/layouts/Base.astro";
import Lightbox from "@/components/Lightbox.astro";
import SubNav from "@/components/SubNav.astro";

const subNav = [
  { label: "Registration", href: "/en/competition/#registration" },
  { label: "Rules", href: "/en/competition/#rules" },
  { label: "Pass", href: "/en/competition/#fullpass" },
  { label: "Competitors", href: "/en/competitors/", active: true },
  { label: "Winners 2025", href: "/en/winners-2025/" },
  { label: "Winners 2024", href: "/en/winners/" },
];
import { img } from "@/data/img.js";
import { COMP_BASE, COMP_CATS, COMP_BY_CAT } from "@/data/competidores2026.js";
const anchor = (key) => "cat-" + key.replace("/", "-");
// Short chip: drop "Bachata"/"Salsa" from the text (already in the group heading).
const shortCat = (s) => s.replace(/\b(Bachata|Salsa)\b/gi, "").replace(/\s{2,}/g, " ").replace(/^\s*·\s*/, "").replace(/\s*·\s*$/, "").replace(/\s+·/g, " ·").trim();
const STYLES = [{ key: "bachata", label: "Bachata" }, { key: "salsa", label: "Salsa" }];

const categories = [
  { label: "Male salsa duos", img: "DUOS-MASCULINO-SALSA-2025.jpeg" },
  { label: "Female Salsa Duets", img: "DUOS-FEMENINO-SALSA-2025.jpeg" },
  { label: "Salsa Couples", img: "PAREJAS-SALSA-2025.jpeg" },
  { label: "Salsa Teams", img: "GRUPOS-SALSA-2025.jpeg" },
  { label: "Female salsa soloist (semi)", img: "FINAL-SOLISTAS-FEMENINO-SALSA.jpeg" },
  { label: "Female salsa soloist", img: "ELIMINATORIA-SOLISTAS-FEMENINO-SALSA_1.jpeg" },
  { label: "Male salsa soloist (semi)", img: "semifinal-y-final-chicos-2025.jpeg" },
  { label: "Male salsa soloist", img: "ELIMINATORIA-SOLISTAS-MASCULINO-SALSA-2025.jpeg" },
  { label: "Bachata Female Soloist", img: "SOLISTA-FEM-BACHATA-2025.jpeg" },
  { label: "Bachata Male Soloist", img: "SOLISTA-MAS-BACHATA-2025.jpeg" },
  { label: "Bachata duos", img: "DUOS-BACHATA-2025.jpeg" },
  { label: "Bachata Couples", img: "PAREJAS-BACHATA-2025.jpeg" },
  { label: "Bachata Teams", img: "equipo-bahatca-final-festival-la-negra-2.jpg" },
];

const gallery = [
  "lanegra-dance-festival-home-1-7.webp",
  "lanegra-dance-festival-home-3-2.webp",
  "lanegra-dance-festival-home-3-10.webp",
  "lanegra-dance-festival-home-3-13.webp",
  "lanegra-dance-festival-home-3-14.webp",
  "lanegra-dance-festival-home-3-22.webp",
  "lanegra-dance-festival-home-3-23.webp",
  "lanegra-dance-festival-home-3-26.webp",
];
---

<Base title="Competitors" description="The competitors of La Negra Dance Festival's Salsa and Bachata World Cup." lang="en">
  <SubNav items={subNav} label="Competition sections" />

  <div class="prop">
    <!-- COMPETITORS 2026 -->
    <section id="competidores-2026" class="p-section p-center comp26">
      <div class="p-container">
        <p class="p-eyebrow">Pasos Libres World Championship · 2026</p>
        <h1 class="p-display">Competitors 2026</h1>
        <p class="p-lead p-narrow">The 411 dancers from all over the world who will compete in Calpe, October 21–25. Salsa and bachata, from the pre-qualifiers to the grand final.</p>
        <div class="comp-nav-wrap">
          {STYLES.map((st) => (
            <div class="comp-nav-group">
              <h3 class="comp-nav-h">{st.label}</h3>
              <nav class="comp-nav" aria-label={`${st.label} categories`}>
                {COMP_CATS.filter((c) => c.style === st.key).map((c) => (
                  <a href={`#${anchor(c.key)}`}>{shortCat(c.en)}<span class="comp-nav-n">{c.n}</span></a>
                ))}
              </nav>
            </div>
          ))}
        </div>
        {COMP_CATS.map((c) => (
          <div class="comp-cat" id={anchor(c.key)}>
            <h2 class="comp-cat-title">{c.en}<span class="comp-cat-n">{c.n}</span></h2>
            <div class="comp-grid">
              {COMP_BY_CAT[c.key].map((p) => (
                <figure class="comp-card">
                  <img src={`${COMP_BASE}/${p.file}`} alt={p.country ? `${p.name} — ${p.country}` : p.name} loading="lazy" data-lightbox role="button" tabindex="0" />
                  <figcaption class="comp-name">{p.name}</figcaption>
                </figure>
              ))}
            </div>
          </div>
        ))}
      </div>
    </section>

    <!-- INTRO + GRID (2025) -->
    <section class="p-section p-center competitors p-gray">
      <div class="p-container">
        <p class="p-eyebrow">Previous editions</p>
        <h2 class="p-h2">Competitors in 2025</h2>
        <div class="cat-grid">
          {categories.map((c) => (
            <article class="cat-card">
              <div class="cat-img"><img src={img(c.img)} alt={c.label} loading="lazy" data-lightbox role="button" tabindex="0" /></div>
              <h3 class="cat-label">{c.label}</h3>
            </article>
          ))}
        </div>
      </div>
    </section>

    <!-- GALLERY -->
    <section class="p-section p-gray">
      <div class="p-container gallery-grid">
        {gallery.map((src) => (
          <div class="gallery-item"><img src={img(src)} alt="" loading="lazy" /></div>
        ))}
      </div>
    </section>

    <!-- FINAL CTA -->
    <section class="p-section p-center final-cta">
      <div class="p-container">
        <p class="p-eyebrow">Enjoy dancing</p>
        <h2 class="p-h2">Your Latin dance festival</h2>
        <p class="p-lead p-narrow final-text">Three days of salsa and bachata, for those in love with Latin dance. Pure fire on the dance floor: artists, contestants, workshops, parties and lots of rhythm. Not to be missed, from October 21 to 25, 2026 in Calpe (Spain).</p>
      </div>
      <div class="p-container cta-box">
        <div class="cta-img"><img src={img("lanegra-dance-festival-home-1-7.webp")} alt="" loading="lazy" /></div>
        <div class="cta-content">
          <p>An international Salsa and Bachata festival and dance competition.</p>
          <p class="cta-claim">Come, dance and enjoy!</p>
          <div class="cta-buttons">
            <a class="p-btn p-btn-light" href="/en/your-pass/">Buy Pass</a>
            <span class="reg-closed"><span class="p-btn p-btn-off" aria-disabled="true" role="button" title="Registration closed">Register for the World Cup</span><span class="reg-note">Registration closed: the sign-up period for the 2026 World Cup has ended.</span></span>
          </div>
        </div>
      </div>
    </section>
  </div>
  <Lightbox />
</Base>

<style>
  /* COMPETIDORES 2026 */
  .comp26 .p-display { margin-bottom: 14px; }
  .comp26 .p-lead { margin-bottom: 30px; }
  .comp-nav-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 8px 40px; max-width: 1000px; margin: 4px auto 8px; text-align: left; }
  .comp-nav-group { margin-top: 22px; }
  .comp-nav-h { font-size: 13px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--gold); margin: 0 0 14px; padding-bottom: 9px; border-bottom: 1px solid rgba(0, 0, 0, .1); }
  .comp-nav { display: flex; flex-wrap: wrap; gap: 12px; justify-content: flex-start; margin: 0; }
  .comp-nav a { display: flex; align-items: center; justify-content: space-between; gap: 10px; flex: 0 0 100%; box-sizing: border-box; min-height: 50px; padding: 8px 12px 8px 16px; border-radius: 10px; font-size: 13px; font-weight: 600; line-height: 1.25; text-align: left; background: var(--p-card, #f1eee9); color: var(--p-ink); text-decoration: none; transition: background .2s, color .2s; }
  .comp-nav a:hover { background: var(--gold); color: #fff; }
  .comp-nav-n { flex: none; display: inline-flex; align-items: center; justify-content: center; width: 26px; height: 26px; border-radius: 50%; background: #fff; color: var(--p-ink); font-size: 12px; font-weight: 700; }
  @media (max-width: 720px) {
    .comp-nav-wrap { grid-template-columns: 1fr; gap: 22px; }
    .comp-nav a { flex: 0 0 calc(50% - 6px); }
  }
  .comp-cat { margin-top: 52px; }
  .comp-cat-title { display: flex; align-items: center; justify-content: center; gap: 12px; font-size: clamp(20px, 2.4vw, 28px); font-weight: 700; letter-spacing: -.02em; color: var(--p-ink); margin: 0 0 26px; }
  .comp-cat-n { font-size: 14px; font-weight: 700; color: #fff; background: var(--gold); border-radius: 999px; padding: 2px 10px; }
  .comp-grid { display: grid; grid-template-columns: repeat(8, 1fr); gap: 20px 14px; }
  .comp-card { margin: 0; }
  .comp-card img { width: 100%; aspect-ratio: 3/4; object-fit: cover; border-radius: 14px; background: var(--p-card, #eee); cursor: zoom-in; transition: transform .3s ease, box-shadow .3s ease; display: block; }
  .comp-card img:hover { transform: translateY(-4px); box-shadow: 0 14px 30px rgba(0, 0, 0, .18); }
  .comp-name { margin: 12px 6px 0; font-size: 14px; font-weight: 600; color: var(--p-ink); line-height: 1.3; text-align: center; }
  @media (max-width: 1100px) { .comp-grid { grid-template-columns: repeat(6, 1fr); } }
  @media (max-width: 820px) { .comp-grid { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 520px) { .comp-grid { grid-template-columns: repeat(3, 1fr); gap: 14px 10px; } }

  /* CATEGORY GRID */
  .competitors .p-display { margin-bottom: 48px; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 40px 30px; margin-top: 8px; }
  .cat-card { text-align: center; }
  .cat-img { border-radius: 18px; overflow: hidden; aspect-ratio: 3/4; margin-bottom: 18px; background: var(--p-card); }
  .cat-img img { width: 100%; height: 100%; object-fit: cover; cursor: zoom-in; transition: transform .4s ease; }
  .cat-card:hover .cat-img img { transform: scale(1.04); }
  .cat-label {
    font-weight: 700; text-transform: uppercase;
    font-size: 15px; letter-spacing: .06em; margin: 0; color: var(--p-ink);
  }

  /* GALLERY */
  .gallery-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; }
  .gallery-item { border-radius: 18px; overflow: hidden; aspect-ratio: 1/1; background: var(--p-card); }
  .gallery-item img { width: 100%; height: 100%; object-fit: cover; }

  /* FINAL CTA */
  .final-text { margin-bottom: 44px; }
  .cta-box { display: grid; grid-template-columns: 1fr 1fr; align-items: stretch; border-radius: var(--p-radius); overflow: hidden; margin-top: 8px; }
  .cta-img img { width: 100%; height: 100%; object-fit: cover; }
  .cta-content {
    background: radial-gradient(120% 120% at 50% 0%, #211c33 0%, #0f0b1e 65%);
    color: #fff; padding: clamp(36px, 5vw, 56px) clamp(30px, 4vw, 48px);
    display: flex; flex-direction: column; justify-content: center; text-align: left;
  }
  .cta-content p { color: rgba(255, 255, 255, .82); line-height: 1.6; margin: 0; }
  .cta-claim { font-weight: 700; letter-spacing: -.02em; color: #fff !important; font-size: clamp(24px, 3vw, 30px); margin: 10px 0 26px !important; }
  .cta-buttons { display: flex; gap: 14px; flex-wrap: wrap; align-items: flex-start; }
  .reg-closed { display: flex; flex-direction: column; align-items: flex-start; gap: 8px; }
  .reg-closed .p-btn-off { text-decoration: line-through; text-decoration-thickness: 2px; cursor: not-allowed; opacity: .5; background: transparent; color: #fff; border: 1.5px solid rgba(255, 255, 255, .4); }
  .reg-closed .p-btn-off:hover { transform: none; }
  .reg-note { font-size: 12px; color: rgba(255, 255, 255, .6); text-align: left; max-width: 260px; line-height: 1.4; }

  /* responsive */
  @media (max-width: 900px) {
    .cat-grid { grid-template-columns: repeat(2, 1fr); }
    .gallery-grid { grid-template-columns: repeat(2, 1fr); }
    .cta-box { grid-template-columns: 1fr; }
  }
  @media (max-width: 560px) {
    .cat-grid { grid-template-columns: 1fr; }
  }
</style>
