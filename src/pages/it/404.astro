---
import Base from "@/layouts/Base.astro";
---
<Base noindex title="Pagina non trovata — La Negra Dance Festival" lang="it">
  <section class="notfound text-center">
    <div class="container">
      <p class="code">404</p>
      <h1 class="script-title">Pagina non trovata</h1>
      <p class="msg">La pagina che stai cercando non esiste o ha cambiato indirizzo.</p>
      <div class="actions">
        <a class="btn btn-solid" href="/it/">Torna alla home</a>
        <a class="btn btn-outline" href="/it/programma-2026/">Programma 2026</a>
        <a class="btn btn-outline" href="/it/contact/">Contatti</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .notfound { padding: 110px 0 120px; }
  .code { font-family: var(--font-script); color: var(--gold); font-size: clamp(90px, 20vw, 180px); line-height: 1; margin: 0; }
  .script-title { margin-top: 6px; }
  .msg { color: var(--text); font-size: 18px; margin: 6px 0 28px; }
  .actions { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }
</style>
