---
import Base from "@/layouts/Base.astro";
import { img } from "@/data/img.js";
import { BIOS, IMG_TO_NAME } from "@/data/artist-bios.js";
import { SALSA, BACHATA } from "@/data/artists.js";
import ArtistModal from "@/components/ArtistModal.astro";

const salsa = SALSA.es;
const bachata = BACHATA.es;

const igIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.6.2 1 .5 1.4.9.4.4.7.8.9 1.4.2.4.4 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.6-.5 1-.9 1.4-.4.4-.8.7-1.4.9-.4.2-1 .4-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4-.6-.2-1-.5-1.4-.9-.4-.4-.7-.8-.9-1.4-.2-.4-.4-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.6.5-1 .9-1.4.4-.4.8-.7 1.4-.9.4-.2 1-.4 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 4.9a4.9 4.9 0 1 0 0 9.8 4.9 4.9 0 0 0 0-9.8zm0 8.1a3.2 3.2 0 1 1 0-6.4 3.2 3.2 0 0 1 0 6.4zm6.3-8.3a1.1 1.1 0 1 1-2.3 0 1.1 1.1 0 0 1 2.3 0z"/></svg>`;
const ytIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M23 12s0-3.2-.4-4.7a2.5 2.5 0 0 0-1.7-1.7C19.4 5.2 12 5.2 12 5.2s-7.4 0-8.9.4A2.5 2.5 0 0 0 1.4 7.3C1 8.8 1 12 1 12s0 3.2.4 4.7a2.5 2.5 0 0 0 1.7 1.7c1.5.4 8.9.4 8.9.4s7.4 0 8.9-.4a2.5 2.5 0 0 0 1.7-1.7C23 15.2 23 12 23 12zM9.7 15.3V8.7l5.8 3.3-5.8 3.3z"/></svg>`;
const fbIcon = `<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M22 12a10 10 0 1 0-11.6 9.9v-7H7.9V12h2.5V9.8c0-2.5 1.5-3.9 3.8-3.9 1.1 0 2.2.2 2.2.2v2.5h-1.2c-1.2 0-1.6.8-1.6 1.6V12h2.7l-.4 2.9h-2.3v7A10 10 0 0 0 22 12z"/></svg>`;
---

<Base title="Artistas" description="Descubre la constelación de estrellas de la salsa y la bachata de La Negra Dance Festival." lang="es">
  <div class="prop">
  <!-- INTRO -->
  <section class="p-section p-center">
    <div class="p-container">
      <p class="p-eyebrow">Salsa - Bachata</p>
      <h1 class="p-display">Los artistas<br /><span class="intro-fest">La Negra Dance Festival</span></h1>
      <p class="intro-date">Del 21 al 25 de octubre del 2026 en Calpe (España)</p>
      <div class="intro-nav">
        <a class="p-btn p-btn-light" href="#salsa">Ver artistas Salsa</a>
        <a class="p-btn p-btn-light" href="#bachata">Ver artistas Bachata</a>
      </div>
    </div>
  </section>

  <!-- SALSA -->
  <section id="salsa" class="p-section p-center">
    <div class="p-container">
      <p class="p-eyebrow">Artistas de Salsa</p>
      <h2 class="p-h2">Nuestras Estrellas Salseras</h2>
      <p class="p-lead p-narrow">Las mejores estrellas nacionales e internacionales de la salsa, desde los grandes maestros hasta las nuevas generaciones que están sorprendiendo al mundo se reúnen aquí para ofrecer workshops y masterclass especializadas, con un alto nivel pedagógico. Muchos de ellos también son jurado de nuestro prestigioso mundial. Los más populares estilos de bailes de Cuba, Puerto Rico, Nueva York, Cali, lo tradicional, lo urbano, las fusiones vendrán de la mano de estas leyendas.</p>
      <div class="artists-grid">
        {salsa.map((a) => (
          <article class="artist">
            <button type="button" class="artist-img" data-artist data-aname={a.name} data-acountry={a.country} data-abio={BIOS[a.name] || BIOS[IMG_TO_NAME[a.img]] || ""} data-aig={a.ig || ""} data-afb={a.fb || ""} data-ayt={a.yt || ""}>
              <img src={img(a.img)} alt={a.name} loading="lazy" />
            </button>
            <h3 class="artist-name">{a.name}</h3>
            <p class="artist-country">{a.country}</p>
            <div class="artist-social">
              {a.fb && <a href={a.fb} target="_blank" rel="noopener" aria-label="Facebook" set:html={fbIcon}></a>}
              {a.ig && <a href={a.ig} target="_blank" rel="noopener" aria-label="Instagram" set:html={igIcon}></a>}
              {a.yt && <a href={a.yt} target="_blank" rel="noopener" aria-label="YouTube" set:html={ytIcon}></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- BACHATA -->
  <section id="bachata" class="p-section p-center p-gray">
    <div class="p-container">
      <p class="p-eyebrow">Artistas de Bachata</p>
      <h2 class="p-h2">Nuestras Estrellas Bachateras</h2>
      <p class="p-lead p-narrow">La bachata conquistó al mundo y aquí tienes un abanico de todos los estilos y formas de bailarla desde lo más puro y tradicional, hasta la sensual y las diferentes fusiones que respetan la esencia de la verdadera bachata nacida en República Dominicana. De la mano de estas estrellas internacionales recibirás talleres, masterclass y muchos serán parte del gran jurado del Mundial de Pasos Libres de Bachata.</p>
      <div class="artists-grid">
        {bachata.map((a) => (
          <article class="artist">
            <button type="button" class="artist-img" data-artist data-aname={a.name} data-acountry={a.country} data-abio={BIOS[a.name] || BIOS[IMG_TO_NAME[a.img]] || ""} data-aig={a.ig || ""} data-afb={a.fb || ""} data-ayt={a.yt || ""}>
              <img src={img(a.img)} alt={a.name} loading="lazy" />
            </button>
            <h3 class="artist-name">{a.name}</h3>
            <p class="artist-country">{a.country}</p>
            <div class="artist-social">
              {a.fb && <a href={a.fb} target="_blank" rel="noopener" aria-label="Facebook" set:html={fbIcon}></a>}
              {a.ig && <a href={a.ig} target="_blank" rel="noopener" aria-label="Instagram" set:html={igIcon}></a>}
              {a.yt && <a href={a.yt} target="_blank" rel="noopener" aria-label="YouTube" set:html={ytIcon}></a>}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
  </div>
  <ArtistModal closeLabel="Cerrar" />
</Base>

<style>
  /* INTRO */
  .intro-fest { display: block; font-size: .46em; font-weight: 600; letter-spacing: -.01em; opacity: .82; margin-top: .12em; }
  .intro-date { font-size: 20px; font-weight: 300; color: var(--gold-dark); margin: 4px 0 24px; }
  .intro-nav { display: flex; gap: 16px; justify-content: center; flex-wrap: wrap; }

  /* ARTISTS */
  .artists-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 40px 30px; margin-top: 44px; }
  .artist { display: flex; flex-direction: column; align-items: center; }
  .artist-img {
    position: relative; width: 82%; aspect-ratio: 1; overflow: hidden; margin-bottom: 18px;
    padding: 0; border: 0; background: none; cursor: pointer; display: block;
    border-radius: 42% 58% 47% 53% / 52% 43% 57% 48%;
    transition: border-radius .7s ease, transform .4s ease;
  }
  /* Pista de que es pulsable: velo + "+" al pasar el ratón o enfocar */
  .artist-img::after {
    content: "+"; position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
    font-size: 42px; font-weight: 300; line-height: 1; color: #fff; background: rgba(15, 11, 30, .34);
    opacity: 0; transition: opacity .3s;
  }
  .artist-img:hover::after, .artist-img:focus-visible::after { opacity: 1; }
  .artist:nth-child(2n) .artist-img { border-radius: 58% 42% 55% 45% / 45% 57% 43% 55%; }
  .artist:nth-child(3n) .artist-img { border-radius: 50% 50% 42% 58% / 60% 40% 55% 45%; }
  .artist:nth-child(4n) .artist-img { border-radius: 46% 54% 60% 40% / 48% 58% 42% 55%; }
  .artist:hover .artist-img { border-radius: 50%; transform: translateY(-5px) scale(1.03); }
  .artist-img img { width: 100%; height: 100%; object-fit: cover; }
  .artist-name { font-family: var(--font-body); font-weight: 600; font-size: clamp(19px, 1.6vw, 25px); letter-spacing: -.02em; margin: 0 0 2px; color: var(--p-ink); }
  .artist-country { color: var(--gold-dark); font-size: 14px; margin: 0 0 10px; }
  .artist-social { display: flex; gap: 8px; justify-content: center; }
  .artist-social a {
    display: inline-flex; align-items: center; justify-content: center;
    width: 34px; height: 34px; border-radius: 50%;
    background: var(--gold); color: #fff;
  }
  .artist-social a:hover { background: var(--gold-dark); }

  /* responsive */
  @media (max-width: 900px) {
    .artists-grid { grid-template-columns: repeat(2, 1fr); }
  }
</style>
