---
import Base from "@/layouts/Base.astro";

// Especialidades. minInt/maxInt = nº de integrantes permitido en cada modalidad.
const ESPECIALIDADES = [
  { v: "Bachata · Solista Femenino", min: 1, max: 1 },
  { v: "Bachata · Solista Masculino", min: 1, max: 1 },
  { v: "Bachata · Dúos", min: 2, max: 2 },
  { v: "Bachata · Parejas", min: 2, max: 2 },
  { v: "Bachata · Equipos", min: 3, max: 30 },
  { v: "Salsa · Solista Femenino", min: 1, max: 1 },
  { v: "Salsa · Solista Masculino", min: 1, max: 1 },
  { v: "Salsa · Dúos Femeninos", min: 2, max: 2 },
  { v: "Salsa · Dúos Masculinos", min: 2, max: 2 },
  { v: "Salsa · Parejas", min: 2, max: 2 },
  { v: "Salsa · Equipos", min: 3, max: 30 },
];
---

<Base title="Envío de solicitudes 2027" description="Envío de solicitudes para competir en el Mundial de Pasos Libres 2027. Solicitar no garantiza la plaza." lang="es">
  <meta slot="head" name="robots" content="noindex, nofollow" />

  <div class="prop">
    <section class="p-section p-center ins">
      <div class="p-container">
        <p class="p-eyebrow">Inscripciones 2027 · 20 al 24 de octubre · Calpe, España</p>
        <h1 class="p-display">Envío de solicitudes</h1>

        {/* Que quede claro desde el primer momento: mandar la solicitud no es
            tener la plaza. Lo pidió la organización por las confusiones de 2026. */}
        <p class="p-lead p-narrow ins-aclara">
          Esto es una <strong>solicitud</strong>, no una inscripción. La organización revisa cada
          envío y confirma después quién entra en el campeonato.
        </p>

        <div class="ins-plazo">
          <div><span class="ins-plazo-k">Apertura</span><strong>23 de octubre</strong></div>
          <div><span class="ins-plazo-k">Cierre</span><strong>15 de diciembre</strong><em>no prorrogable</em></div>
        </div>

        <!-- PUERTA DE ACCESO -->
        <div id="ins-gate" class="ins-box">
          <p class="p-lead p-narrow">Zona privada. Introduce la contraseña que te ha facilitado la organización para acceder al formulario de inscripción.</p>
          <div class="gate-row">
            <input id="gate-pass" type="password" placeholder="Contraseña" autocomplete="off" />
            <button id="gate-btn" type="button" class="p-btn p-btn-solid">Entrar</button>
          </div>
          <p id="gate-msg" class="ins-msg" role="alert"></p>
        </div>

        <!-- FORMULARIO -->
        <form id="ins-form" class="ins-form" hidden novalidate>

          <!-- PASO 1 · ESPECIALIDAD -->
          <div class="step">
            <p class="step-n">Paso 1</p>
            <label class="fld"><span>Especialidad <span class="req">*</span></span>
              <select name="especialidad" id="especialidad" required>
                <option value="" disabled selected>Elige la categoría…</option>
                {ESPECIALIDADES.map((e) => <option value={e.v} data-min={e.min} data-max={e.max}>{e.v}</option>)}
              </select>
            </label>
            <p class="step-hint" id="esp-hint">Elige primero la categoría: según la modalidad se pedirán los datos de uno o de varios integrantes.</p>
          </div>

          <!-- PASO 2 · INTEGRANTES (se genera al elegir especialidad) -->
          <div class="step" id="step-int" hidden>
            <p class="step-n">Paso 2</p>
            <label class="fld" id="fld-grupo" hidden><span id="grupo-label">Nombre artístico <span class="req">*</span></span><input name="grupo" type="text" /><span class="fld-hint" id="grupo-hint">Es el nombre que aparecerá en el cartel si resultas seleccionado.</span></label>
            <div class="int-head">
              <span class="int-title" id="int-title">Datos de los integrantes</span>
              <p class="int-note" id="int-note"></p>
            </div>
            <div id="int-list"></div>
            <button type="button" id="int-add" class="int-add" hidden>+ Añadir integrante</button>
          </div>

          <!-- PASO 3 · DATOS DE LA INSCRIPCIÓN -->
          <div class="step" id="step-comun" hidden>
            <p class="step-n">Paso 3</p>

            <!-- FOTO -->
            <div class="fld foto-fld">
              <span id="foto-label">Foto <span class="req">*</span></span>
              <div class="foto-wrap">
                <div class="foto-help">
                  <p><strong>Cómo debe ser la foto:</strong></p>
                  <ul>
                    <li id="help-caras">Las caras deben quedar <strong>dentro del círculo</strong> que ves en el ejemplo, dejando algo de espacio con el borde de la foto (no peguéis las cabezas al filo).</li>
                    <li>De cintura para arriba, fondo neutro y buena iluminación. <strong>¡Os queremos increíbles!</strong></li>
                    <li>Mirando a cámara y con la cara bien visible. Podéis llevar gorra, siempre que no os tape la cara.</li>
                    <li><strong>Sin texto, logos, marcos ni collages</strong>, y que no sea una captura de pantalla: mandad la foto original.</li>
                    <li id="help-juntos">En dúos y parejas, los dos en la misma foto.</li>
                    <li id="help-ratio">Formato JPG o PNG, <strong>máximo 5 MB</strong>.</li>
                  </ul>
                  <figure class="foto-ejemplo">
                    <!-- Si aún no existe la guía 4:3 de grupos, se muestra la 1:1 -->
                    <img id="foto-ejemplo-img" src="/img/preview-1-1.webp" alt="Ejemplo: las caras dentro del círculo, con espacio hasta el borde" loading="lazy" decoding="async" onerror="if(!this.src.endsWith('preview-1-1.webp')){this.src='/img/preview-1-1.webp';}" />
                    <figcaption>Ejemplo: las caras, dentro del círculo verde</figcaption>
                  </figure>
                </div>
                <div class="foto-drop">
                  <input id="foto-input" name="foto" type="file" accept="image/jpeg,image/png" />
                  <p class="foto-ratio" id="foto-ratio"></p>
                  <!-- Previsualización sobre el cartel real: la plantilla va encima y su
                       ventana transparente deja ver la foto recortada debajo. -->
                  <figure class="cartel" id="cartel" hidden>
                    <div class="cartel-inner">
                      <div class="cartel-foto" id="cartel-foto"><img id="cartel-foto-img" alt="Tu foto en el cartel" /></div>
                      <img class="cartel-marco" src="/img/preview.webp" alt="" />
                    </div>
                  </figure>
                </div>
              </div>
            </div>

            {/* Logotipo · solo tiene sentido si hay escuela o compañía detrás. */}
            <div class="fld-set logo-set">
              <legend>Logotipo de la escuela o compañía</legend>
              <p class="fld-ayuda">Opcional. JPG o PNG, máximo 5 MB. Si lo tienes en PNG con fondo transparente, mejor.</p>
              <input id="logo-input" name="logo" type="file" accept="image/jpeg,image/png" />
              <p class="logo-nombre" id="logo-nombre"></p>
            </div>

            <label class="fld"><span id="video-label">Enlace a un vídeo bailando (YouTube o Instagram) <span class="req">*</span></span>
              <input name="video" type="url" placeholder="https://…" required />
            </label>

            <div class="grid2">
              <label class="fld" id="fld-email"><span id="email-label">Email de contacto <span class="req">*</span></span><input name="email" type="email" required /></label>
              <label class="fld"><span>Teléfono / WhatsApp <span class="req">*</span></span><input name="telefono" type="tel" required /></label>
              <label class="fld"><span>Academia / Escuela</span><input name="academia" type="text" /></label>
              <label class="fld"><span>Ciudad</span><input name="ciudad" type="text" /></label>
            </div>
            {/* Otras categorías · el tope de 3 lo marca la organización, contando esta. */}
            <fieldset class="fld-set">
              <legend>¿En qué otras categorías de 2027 te postulas?</legend>
              <p class="fld-ayuda">Máximo 3 en total, contando la de arriba. Deja en blanco si solo te presentas a una.</p>
              <div class="cats" id="otras-cats">
                {ESPECIALIDADES.map((e) => (
                  <label class="cat"><input type="checkbox" value={e.v} /> <span>{e.v}</span></label>
                ))}
              </div>
              <p class="cats-cuenta" id="cats-cuenta"></p>
            </fieldset>

            {/* Historial · ayuda a la organización a valorar la solicitud. */}
            <fieldset class="fld-set">
              <legend>¿Has participado en ediciones anteriores del campeonato?</legend>
              <div class="grid2">
                <label class="fld"><span>¿Cuántas veces?</span><input name="veces_participado" type="number" min="0" max="20" placeholder="0" /></label>
                <label class="fld"><span>¿En qué años y categorías?</span><input name="ediciones_previas" type="text" placeholder="Ej.: 2025 Salsa Parejas, 2024 Salsa Equipos" /></label>
              </div>
              <label class="fld"><span>Resultado reseñable</span><input name="resultado_previo" type="text" placeholder="Ej.: finalista 2025, 3er puesto 2024…" /></label>
            </fieldset>

            <label class="fld"><span>Observaciones</span><textarea name="observaciones" rows="3"></textarea></label>

            <label class="chk"><input type="checkbox" name="acepta_bases" required /> <span>He leído y acepto las <a href="/bases-y-reglamento/" target="_blank" rel="noopener">bases y el reglamento</a> del campeonato. <span class="req">*</span></span></label>
            <label class="chk"><input type="checkbox" name="acepta_rgpd" required /> <span>Acepto la <a href="/politica-de-privacidad/" target="_blank" rel="noopener">política de privacidad</a> y el uso de la imagen para la promoción del festival. <span class="req">*</span></span></label>

            <button type="submit" id="ins-submit" class="p-btn p-btn-solid ins-submit">Enviar solicitud</button>
            <p id="ins-msg" class="ins-msg" role="alert"></p>
          </div>
        </form>

        <!-- ÉXITO -->
        <div id="ins-ok" class="ins-box ins-ok" hidden>
          <h2 class="ins-ok-title">¡Solicitud enviada! ✅</h2>
          <p class="p-narrow">Hemos recibido tu solicitud. La organización la revisará y te escribirá para confirmarte si entras en el campeonato. ¡Gracias!</p>
          <button type="button" id="ins-again" class="p-btn p-btn-light">Hacer otra inscripción</button>
        </div>
      </div>
    </section>
  </div>
</Base>

<style>
  .ins .p-display { margin-bottom: 22px; }
  .ins-box { max-width: 560px; margin: 0 auto; background: var(--p-card, #f6f2ec); border-radius: 16px; padding: clamp(24px, 4vw, 40px); text-align: center; }
  .gate-row { display: flex; gap: 10px; justify-content: center; flex-wrap: wrap; margin-top: 18px; }
  .gate-row input { flex: 1 1 240px; max-width: 300px; padding: 13px 16px; border: 1.5px solid #d8d2c7; border-radius: 10px; font-size: 16px; }
  .ins-aclara { margin-top: 10px; }
  .ins-plazo { display: flex; flex-wrap: wrap; justify-content: center; gap: 12px; margin: 18px 0 6px; }
  .ins-plazo > div { background: #fff; border: 1px solid #ece7dd; border-radius: 14px; padding: 12px 20px; min-width: 150px; }
  .ins-plazo-k { display: block; font-size: 11px; font-weight: 800; text-transform: uppercase; letter-spacing: .08em; color: #8a8578; margin-bottom: 2px; }
  .ins-plazo strong { display: block; font-size: 16px; color: #14121a; }
  .ins-plazo em { display: block; font-size: 11.5px; font-style: normal; color: #c0392b; font-weight: 700; margin-top: 2px; }

  .fld-set { border: 1px solid #ece7dd; border-radius: 14px; padding: 16px 18px; margin-bottom: 16px; background: #fff; }
  .fld-set legend { font-size: 13.5px; font-weight: 800; color: #14121a; padding: 0 6px; }
  .fld-ayuda { margin: 4px 0 12px; font-size: 12.5px; color: #8a8578; line-height: 1.45; }
  .cats { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 6px 14px; }
  .cat { display: flex; align-items: center; gap: 8px; font-size: 13.5px; cursor: pointer; }
  .cat[hidden] { display: none; }
  .cat input:disabled + span { opacity: .45; }
  .cats-cuenta { margin: 10px 0 0; font-size: 12.5px; font-weight: 700; color: var(--gold-dark, #a2823f); }
  .logo-set input[type=file] { font-size: 13.5px; }
  .logo-nombre { margin: 8px 0 0; font-size: 12.5px; color: #6a6a74; }

  .ins-msg { min-height: 20px; margin: 14px 0 0; font-size: 14px; font-weight: 600; color: #c0392b; }
  .ins-msg.ok { color: #1e8449; }

  /* Campo con fallo: borde rojo y el porqué debajo, en rojo. */
  :global(.campo-mal) { border-color: #c0392b !important; background: #fdf3f2; }
  :global(.campo-mal:focus-visible) { outline-color: #c0392b; }
  :global(.campo-err) {
    margin: 6px 0 0; font-size: 13px; font-weight: 600; line-height: 1.35;
    color: #c0392b; display: flex; gap: 6px; align-items: flex-start;
  }
  :global(.campo-err)::before { content: "!"; flex: 0 0 auto; width: 15px; height: 15px; margin-top: 1px; border-radius: 50%; background: #c0392b; color: #fff; font-size: 11px; font-weight: 800; text-align: center; line-height: 15px; }

  /* FORMULARIO */
  .ins-form { max-width: 720px; margin: 0 auto; text-align: left; }
  .req { color: var(--gold-dark, #a2823f); font-weight: 700; }
  .step { margin-top: 30px; padding-top: 26px; border-top: 1px solid rgba(0, 0, 0, .09); }
  .step:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .step-n { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .14em; color: var(--gold); margin: 0 0 12px; }
  .step-hint { font-size: 12.5px; color: var(--p-ink); opacity: .7; margin: 8px 0 0; line-height: 1.45; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .fld { display: block; margin: 16px 0 0; }
  .fld > span { display: block; font-size: 13px; font-weight: 600; color: var(--p-ink); margin: 0 0 6px; }
  .fld input, .fld select, .fld textarea {
    width: 100%; padding: 12px 14px; border: 1.5px solid #d8d2c7; border-radius: 10px;
    font-size: 15px; font-family: inherit; background: #fff; color: var(--text); box-sizing: border-box;
  }
  .fld input:focus, .fld select:focus, .fld textarea:focus { outline: none; border-color: var(--gold); }
  .grid2 .fld { margin: 0; }

  /* INTEGRANTES */
  .int-head { margin-top: 18px; }
  .int-title { display: block; font-size: 13px; font-weight: 700; color: var(--p-ink); }
  .int-note { font-size: 12.5px; color: var(--p-ink); opacity: .72; margin: 4px 0 0; line-height: 1.45; }
  /* Las fichas de integrante las crea el JS, así que estos estilos deben ser
     globales: el scope de Astro solo marca el HTML compilado, no el generado. */
  :global(.int-card) { position: relative; margin-top: 14px; background: #fff; border: 1.5px solid #ece7dd; border-radius: 12px; padding: 16px; }
  :global(.int-card-h) { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 12px; }
  :global(.int-card-t) { font-size: 12px; font-weight: 800; text-transform: uppercase; letter-spacing: .1em; color: var(--gold-dark, #a2823f); }
  :global(.int-del) { border: none; background: #f0e9dd; color: var(--gold-dark, #a2823f); width: 30px; height: 30px; border-radius: 8px; cursor: pointer; font-size: 19px; line-height: 1; flex: none; }
  :global(.int-del:hover) { background: #e6dcc8; }
  :global(.int-grid) { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
  :global(.int-f) { display: block; }
  :global(.int-f > span) { display: block; font-size: 12px; font-weight: 600; color: var(--p-ink); opacity: .85; margin: 0 0 5px; }
  :global(.int-f input), :global(.int-f select) {
    width: 100%; padding: 10px 12px; border: 1.5px solid #d8d2c7; border-radius: 8px;
    font-size: 14px; font-family: inherit; background: #fff; color: var(--text); box-sizing: border-box;
  }
  :global(.int-f input:focus), :global(.int-f select:focus) { outline: none; border-color: var(--gold); }
  :global(.int-f.full) { grid-column: 1 / -1; }
  .int-add { margin-top: 14px; background: transparent; border: 1.5px dashed #cbb98a; color: var(--gold-dark, #a2823f); padding: 10px 16px; border-radius: 8px; font-weight: 700; cursor: pointer; font-size: 13px; }
  .int-add:hover { background: #faf6ee; }
  .int-add:disabled { opacity: .45; cursor: not-allowed; }

  /* FOTO */
  .foto-fld > span { display: block; font-size: 13px; font-weight: 600; color: var(--p-ink); margin: 0 0 6px; }
  .foto-wrap { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; align-items: start; background: #fff; border: 1.5px dashed #d8d2c7; border-radius: 12px; padding: 16px; }
  .foto-help p { margin: 0 0 8px; font-size: 13px; }
  .foto-help ul { margin: 0 0 12px; padding-left: 18px; font-size: 13px; color: var(--p-ink); opacity: .85; line-height: 1.5; }
  .foto-ejemplo { margin: 0; width: 100%; max-width: 200px; }
  .foto-ejemplo img { width: 100%; height: auto; border-radius: 8px; display: block; }
  .foto-ejemplo figcaption { font-size: 11px; color: #999; text-align: center; margin-top: 5px; line-height: 1.35; }
  .foto-drop { display: flex; flex-direction: column; gap: 12px; }
  .foto-ratio { margin: 0; font-size: 12.5px; font-weight: 600; color: var(--gold-dark, #a2823f); line-height: 1.4; }
  .foto-ratio.err { color: #c0392b; }

  /* Previsualización sobre el cartel oficial (plantilla PNG con ventana transparente) */
  .cartel { margin: 0; }
  .cartel-inner { position: relative; width: 100%; max-width: 260px; aspect-ratio: 1080 / 1296; }
  .cartel-marco { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  /* Hueco transparente medido sobre la plantilla (1080×1296): círculo de 676×678 centrado */
  .cartel-foto {
    position: absolute; left: 18.70%; top: 23.61%; width: 62.59%; height: 52.31%;
    border-radius: 50%; overflow: hidden; background: #0d1b24;
  }
  .cartel-foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .cartel figcaption { font-size: 11px; color: #999; margin-top: 6px; }

  /* CHECKBOX */
  .chk { display: flex; gap: 10px; align-items: flex-start; margin: 18px 0 0; font-size: 14px; line-height: 1.45; }
  .chk input { margin-top: 3px; flex: none; width: 18px; height: 18px; accent-color: var(--gold); }
  .chk a { color: var(--gold-dark, #a2823f); font-weight: 700; text-decoration: underline; }
  .lbl-mini { font-weight: 400; opacity: .65; }
  .fld-hint { display: block; font-size: 12px; font-weight: 400; color: var(--p-ink); opacity: .6; margin-top: 5px; }
  :global(.int-edad) { display: block; font-size: 11.5px; font-weight: 600; color: var(--gold-dark, #a2823f); margin-top: 4px; min-height: 14px; }
  :global(.int-aviso) { font-size: 12px; color: var(--p-ink); opacity: .62; margin: 0 0 12px; line-height: 1.4; }

  .ins-submit { margin-top: 28px; width: 100%; }
  .ins-ok-title { color: var(--p-ink); }

  @media (max-width: 620px) {
    .grid2 { grid-template-columns: 1fr; }
    .foto-wrap { grid-template-columns: 1fr; }
    :global(.int-grid) { grid-template-columns: 1fr; }
  }
</style>

<script>
  const $ = (s) => document.querySelector(s);
  const FN = "/.netlify/functions/inscripcion";
  let pass = "";
  let photo = null; // { base64, type, name }

  // --- Puerta de acceso ---
  const gate = $("#ins-gate"), gateMsg = $("#gate-msg"), form = $("#ins-form");
  async function tryLogin() {
    const val = ($("#gate-pass") as HTMLInputElement).value.trim();
    if (!val) return;
    gateMsg.textContent = "Comprobando…"; gateMsg.classList.remove("ok");
    try {
      const r = await fetch(FN, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "auth", password: val }) });
      const d = await r.json();
      if (r.ok && d.ok) { pass = val; gate.hidden = true; form.hidden = false; window.scrollTo({ top: 0, behavior: "smooth" }); }
      else { gateMsg.textContent = d.error || "Contraseña incorrecta."; }
    } catch { gateMsg.textContent = "No se pudo conectar. Inténtalo de nuevo."; }
  }
  $("#gate-btn").addEventListener("click", tryLogin);
  $("#gate-pass").addEventListener("keydown", (e) => { if ((e as KeyboardEvent).key === "Enter") tryLogin(); });

  // --- Integrantes: mismos campos SIEMPRE para cada uno ---
  const sel = $("#especialidad") as HTMLSelectElement;
  const stepInt = $("#step-int"), stepComun = $("#step-comun");
  const fldGrupo = $("#fld-grupo"), grupoInput = fldGrupo.querySelector("input") as HTMLInputElement;
  const grupoLabel = $("#grupo-label");
  const intList = $("#int-list"), intAdd = $("#int-add"), intTitle = $("#int-title"), intNote = $("#int-note");
  let min = 1, max = 1;

  function card(n) {
    const c = document.createElement("div");
    c.className = "int-card";
    c.innerHTML = `
      <div class="int-card-h"><span class="int-card-t">Integrante ${n}</span></div>
      <p class="int-aviso">Se representa a un solo país y hay que estar nacionalizado para hacerlo. La nacionalidad, dónde vives y a quién representas pueden ser tres países distintos: por eso se preguntan por separado.</p>
      <div class="int-grid">
        <label class="int-f"><span>Nombre *</span><input data-c="nombre" type="text" required /></label>
        <label class="int-f"><span>Apellidos *</span><input data-c="apellidos" type="text" required /></label>
        <label class="int-f"><span>Fecha de nacimiento *</span><input data-c="nacimiento" type="date" required /><span class="int-edad" data-edad></span></label>
        <label class="int-f"><span>Nacionalidad *</span><input data-c="pais" type="text" required /></label>
        <label class="int-f"><span>Ciudad donde vive *</span><input data-c="ciudad_res" type="text" required /></label>
        <label class="int-f"><span>País donde vive *</span><input data-c="pais_res" type="text" required /></label>
        <label class="int-f"><span>País al que representa *</span><input data-c="representa" type="text" required /></label>
        <label class="int-f"><span>Documento (DNI/Pasaporte) *</span><input data-c="documento" type="text" required /></label>
        <label class="int-f"><span>Email *</span><input data-c="email" type="email" required /></label>
        <label class="int-f int-tel"><span>Teléfono / WhatsApp *</span><input data-c="telefono" type="tel" /></label>
        <label class="int-f"><span>Instagram</span><input data-c="instagram" type="text" placeholder="@usuario" /></label>
      </div>`;
    return c;
  }
  function renumber() {
    [...intList.querySelectorAll(".int-card")].forEach((c, i) => {
      c.querySelector(".int-card-t").textContent = "Integrante " + (i + 1);
      const h = c.querySelector(".int-card-h");
      const old = h.querySelector(".int-del"); if (old) old.remove();
      if (intList.children.length > min) {
        const b = document.createElement("button");
        b.type = "button"; b.className = "int-del"; b.textContent = "×"; b.setAttribute("aria-label", "Quitar integrante");
        b.addEventListener("click", () => { c.remove(); renumber(); });
        h.appendChild(b);
      }
    });
    (intAdd as HTMLButtonElement).disabled = intList.children.length >= max;
  }
  function addCard() { intList.appendChild(card(intList.children.length + 1)); renumber(); }

  sel.addEventListener("change", () => {
    const opt = sel.selectedOptions[0];
    min = Number(opt.dataset.min || 1); max = Number(opt.dataset.max || 1);
    intList.innerHTML = "";
    for (let i = 0; i < min; i++) addCard();
    const esGrupo = max > 2;
    // Nombre artístico: se pide siempre (es el que irá en el cartel si sale seleccionado)
    fldGrupo.hidden = false;
    grupoInput.required = esGrupo;
    grupoLabel.innerHTML = esGrupo
      ? 'Nombre del grupo <span class="req">*</span>'
      : 'Nombre artístico <span class="lbl-mini">(opcional)</span>';
    // Teléfono por integrante solo en solistas y dúos/parejas (en equipos basta el del responsable)
    intList.querySelectorAll(".int-tel").forEach((el) => {
      const inp = el.querySelector("input") as HTMLInputElement;
      (el as HTMLElement).hidden = esGrupo; inp.required = !esGrupo;
      if (esGrupo) inp.value = "";
    });
    // El vídeo se pide del estilo de la categoría elegida
    const estilo = String(sel.value).split(" · ")[0];
    $("#video-label").innerHTML = `Enlace al vídeo de <strong>${estilo}</strong> (YouTube o Instagram) <span class="req">*</span>`;
    intTitle.textContent = min === 1 ? "Datos del competidor" : "Datos de cada integrante";
    intNote.textContent = max === 1
      ? "Rellena los datos del competidor."
      : (esGrupo
        ? `Rellena los mismos datos para cada integrante. Mínimo ${min}; usa “+ Añadir integrante” para el resto.`
        : "Rellena los mismos datos para los dos integrantes.");
    intAdd.hidden = max <= min;
    $("#foto-label").innerHTML = (max === 1 ? "Foto del competidor" : esGrupo ? "Foto del grupo (una sola, con todos)" : "Foto de la pareja (una sola, con los dos)") + ' <span class="req">*</span>';
    // En solistas el email ya se pide en la ficha del competidor: no se repite aquí.
    const fldEmail = $("#fld-email"), inpEmail = fldEmail.querySelector("input") as HTMLInputElement;
    fldEmail.hidden = max === 1;
    inpEmail.required = max !== 1;
    if (max === 1) inpEmail.value = "";
    else $("#email-label").innerHTML = 'Email de contacto <span class="req">*</span> <span class="lbl-mini">(persona responsable de la inscripción)</span>';

    stepInt.hidden = false; stepComun.hidden = false;
    $("#esp-hint").hidden = true;
    // Si ya había foto, se vuelve a recortar con la proporción de la nueva categoría
    paintRatioHint();
    if (lastFile) processPhoto(lastFile);
  });
  intAdd.addEventListener("click", () => {
    addCard();
    const esGrupo = max > 2;
    const ult = intList.querySelector(".int-card:last-child .int-tel") as HTMLElement;
    if (ult) { const i = ult.querySelector("input") as HTMLInputElement; ult.hidden = esGrupo; i.required = !esGrupo; }
  });

  // Edad que tendrá el competidor durante el evento (21 oct 2026)
  const EVENTO = new Date("2026-10-21T00:00:00+02:00");
  function edadEnEvento(iso) {
    if (!iso) return null;
    const d = new Date(iso); if (isNaN(+d)) return null;
    let a = EVENTO.getFullYear() - d.getFullYear();
    const m = EVENTO.getMonth() - d.getMonth();
    if (m < 0 || (m === 0 && EVENTO.getDate() < d.getDate())) a--;
    return a >= 0 && a < 120 ? a : null;
  }
  // Al escribir la fecha se muestra la edad que tendrá durante el evento
  intList.addEventListener("input", (e) => {
    const inp = (e.target as HTMLElement).closest('[data-c="nacimiento"]') as HTMLInputElement;
    if (!inp) return;
    const out = inp.parentElement.querySelector("[data-edad]");
    const a = edadEnEvento(inp.value);
    if (out) out.textContent = a === null ? "" : `${a} años durante el evento`;
  });

  function buildIntegrantes() {
    return [...intList.querySelectorAll(".int-card")].map((c, i) => {
      const g = (k) => ((c.querySelector('[data-c="' + k + '"]') as HTMLInputElement).value || "").trim();
      if (!g("nombre") && !g("apellidos")) return null;
      const bits = [`${i + 1}) ${g("nombre")} ${g("apellidos")}`.trim()];
      if (g("nacimiento")) {
        const e = edadEnEvento(g("nacimiento"));
        bits.push(`nacido ${g("nacimiento")}` + (e !== null ? ` (${e} años en el evento)` : ""));
      }
      if (g("pais")) bits.push("nacionalidad " + g("pais"));
      const donde = [g("ciudad_res"), g("pais_res")].filter(Boolean).join(", ");
      if (donde) bits.push("vive en " + donde);
      if (g("representa")) bits.push("representa a " + g("representa"));
      if (g("documento")) bits.push("doc. " + g("documento"));
      if (g("email")) bits.push(g("email"));
      if (g("telefono")) bits.push(g("telefono"));
      if (g("instagram")) bits.push(g("instagram"));
      return bits.join(" · ");
    }).filter(Boolean).join("\n");
  }

  // --- Foto: recorte centrado a la proporción de la categoría + preview sobre el cartel ---
  // Solistas y dúos/parejas → 1:1 (la ventana del cartel es circular).
  // Grupos → 4:3 (en los carteles de equipos la foto es apaisada).
  function ratio() { return max > 2 ? 4 / 3 : 1; }
  // Nada de proporciones técnicas (1:1, 4:3): al competidor le da igual, se recorta solo.
  function paintRatioHint() {
    if (!sel.value) { $("#foto-ratio").textContent = ""; return; }
    $("#foto-ratio").textContent = "";
    const esGrupo2 = max > 2;
    // La medida recomendada solo se indica en solistas y dúos/parejas (foto cuadrada).
    $("#help-ratio").innerHTML = esGrupo2
      ? "Formato JPG o PNG, <strong>máximo 5 MB</strong>. Se recorta sola, no hace falta que la prepares."
      : 'Formato JPG o PNG, <strong>máximo 5 MB</strong>, <strong>cuadrada (1:1)</strong> — por ejemplo <strong>1080 × 1080 px</strong>.';
    ($("#foto-ejemplo-img") as HTMLImageElement).src = esGrupo2 ? "/img/preview-4-3.webp" : "/img/preview-1-1.webp";
    // "Los dos juntos" solo tiene sentido en dúos/parejas; en equipos, que quepan todos.
    const juntos = $("#help-juntos");
    if (max === 1) { juntos.hidden = true; }
    else {
      juntos.hidden = false;
      juntos.innerHTML = esGrupo2
        ? "Salid <strong>todos en la misma foto</strong>, enteros y sin cortar a nadie por los lados."
        : "Los dos <strong>en la misma foto</strong>, no dos fotos sueltas ni un montaje.";
    }
    $("#help-caras").innerHTML = esGrupo2
      ? 'Todas las caras deben quedar <strong>dentro de la zona marcada</strong> del ejemplo, dejando algo de espacio con el borde de la foto.'
      : 'Las caras deben quedar <strong>dentro del círculo</strong> que ves en el ejemplo, dejando algo de espacio con el borde de la foto (no peguéis las cabezas al filo).';
  }

  let lastFile = null;
  function processPhoto(file) {
    if (!file) { photo = null; $("#cartel").hidden = true; return; }
    const img = new Image();
    const url = URL.createObjectURL(file);
    img.onload = () => {
      const r = ratio();
      // Recorte centrado a la proporción pedida
      let sw = img.width, sh = Math.round(sw / r);
      if (sh > img.height) { sh = img.height; sw = Math.round(sh * r); }
      const sx = Math.round((img.width - sw) / 2), sy = Math.round((img.height - sh) / 2);
      // 1080×1080 (cuadrada) o 1440×1080 (apaisada de grupos)
      const outH = 1080, outW = Math.round(outH * r);
      const cv = document.createElement("canvas"); cv.width = outW; cv.height = outH;
      cv.getContext("2d")!.drawImage(img, sx, sy, sw, sh, 0, 0, outW, outH);
      const dataUrl = cv.toDataURL("image/jpeg", 0.85);
      photo = { base64: dataUrl.split(",")[1], type: "image/jpeg", name: (file.name.replace(/\.[^.]+$/, "") || "foto") + ".jpg" };
      ($("#cartel-foto-img") as HTMLImageElement).src = dataUrl;
      $("#cartel").hidden = false;
      $("#foto-ratio").textContent = "Aquí puedes ver cómo se verá tu foto en los carteles.";
      URL.revokeObjectURL(url);
    };
    img.src = url;
  }
  const MAX_FOTO = 5 * 1024 * 1024; // 5 MB
  $("#foto-input").addEventListener("change", (e) => {
    const inp = e.target as HTMLInputElement;
    const f = inp.files?.[0] || null;
    if (f && f.size > MAX_FOTO) {
      const mb = (f.size / 1024 / 1024).toFixed(1);
      $("#foto-ratio").textContent = `La foto pesa ${mb} MB y el máximo son 5 MB. Elige otra o redúcela antes de subirla.`;
      $("#foto-ratio").classList.add("err");
      inp.value = ""; lastFile = null; photo = null; $("#cartel").hidden = true;
      return;
    }
    $("#foto-ratio").classList.remove("err");
    lastFile = f;
    processPhoto(lastFile);
  });

  // --- Otras categorías (tope de 3 contando la principal) ---
  const MAX_CATS = 3;
  const catsBox = $("#otras-cats"), catsCuenta = $("#cats-cuenta");
  const catsInputs = [...catsBox.querySelectorAll("input")] as HTMLInputElement[];

  function pintarCats() {
    // La especialidad principal no se puede marcar también como "otra".
    const principal = sel.value;
    let marcadas = 0;
    catsInputs.forEach((c) => {
      const esPrincipal = c.value === principal;
      c.closest(".cat").hidden = esPrincipal;
      if (esPrincipal) c.checked = false;
      if (c.checked) marcadas++;
    });
    const tope = MAX_CATS - (principal ? 1 : 0);
    catsInputs.forEach((c) => { c.disabled = !c.checked && marcadas >= tope; });
    catsCuenta.textContent = principal
      ? `${marcadas + 1} de ${MAX_CATS} categorías elegidas.`
      : `Elige primero la especialidad principal, arriba.`;
  }
  catsInputs.forEach((c) => c.addEventListener("change", pintarCats));
  sel.addEventListener("change", pintarCats);
  pintarCats();

  // --- Logotipo de la escuela ---
  let logo = null;
  const logoInput = $("#logo-input") as HTMLInputElement, logoNombre = $("#logo-nombre");
  logoInput.addEventListener("change", () => {
    const f = logoInput.files && logoInput.files[0];
    logo = null; logoNombre.textContent = "";
    if (!f) return;
    if (f.size > 5 * 1024 * 1024) { logoNombre.textContent = "Ese archivo pasa de 5 MB. Prueba con uno más ligero."; return; }
    const lector = new FileReader();
    lector.onload = () => {
      logo = { base64: String(lector.result).split(",")[1], type: f.type, name: f.name };
      logoNombre.textContent = "Listo: " + f.name;
    };
    lector.readAsDataURL(f);
  });

  // --- Validación ---
  // El navegador solo enseña el primer error y en un globito que se va solo.
  // Aquí se marcan todos de una vez, en rojo y debajo de cada campo, y se
  // lleva la pantalla al primero.
  const MENSAJES = (el: HTMLInputElement) => {
    const v = el.validity;
    if (v.valueMissing) {
      if (el.type === "checkbox") return "Tienes que marcar esta casilla.";
      if (el.tagName === "SELECT") return "Elige una opción.";
      if (el.type === "date") return "Pon la fecha.";
      if (el.type === "file") return "Adjunta un archivo.";
      return "Rellena este campo.";
    }
    if (v.typeMismatch && el.type === "email") return "Ese email no es válido. Revísalo.";
    if (v.typeMismatch && el.type === "url") return "Pega el enlace completo, empezando por https://";
    if (v.rangeUnderflow || v.rangeOverflow) return "Esa fecha no es correcta.";
    if (v.tooShort) return "Falta texto.";
    return el.validationMessage || "Revisa este campo.";
  };

  function limpiaError(el: Element) {
    el.classList.remove("campo-mal");
    el.removeAttribute("aria-invalid");
    const cont = el.closest("label, .fld, .int-f, .foto-drop") || el.parentElement;
    const previo = cont && cont.querySelector(".campo-err");
    if (previo) previo.remove();
  }

  function ponError(el: Element, texto: string) {
    el.classList.add("campo-mal");
    el.setAttribute("aria-invalid", "true");
    const cont = el.closest("label, .fld, .int-f, .foto-drop") || el.parentElement;
    if (!cont || cont.querySelector(".campo-err")) return;
    const p = document.createElement("p");
    p.className = "campo-err";
    p.textContent = texto;
    cont.appendChild(p);
  }

  function irA(el: Element) {
    const y = el.getBoundingClientRect().top + window.scrollY - 120;
    window.scrollTo({ top: Math.max(0, y), behavior: "smooth" });
    const foco = el as HTMLElement;
    if (typeof foco.focus === "function") setTimeout(() => foco.focus({ preventScroll: true }), 420);
  }

  function validar(): Element[] {
    form.querySelectorAll(".campo-mal").forEach(limpiaError);
    const fallos: Element[] = [];

    form.querySelectorAll("input, select, textarea").forEach((el: any) => {
      if (el.disabled || el.type === "file") return;
      // Un campo escondido (p. ej. el email de solista en grupos) no cuenta.
      if (!el.offsetParent && el.type !== "checkbox") return;
      if (el.checkValidity()) return;
      ponError(el, MENSAJES(el));
      fallos.push(el);
    });

    // Las dos comprobaciones que el navegador no puede hacer.
    if (!photo) {
      const zona = $("#foto-input");
      ponError(zona, "Adjunta la foto: es obligatoria para el cartel.");
      fallos.push(zona);
    }
    if (intList.children.length < min) {
      const ultima = intList.lastElementChild || intList;
      ponError(ultima, `Esta categoría necesita al menos ${min} integrantes.`);
      fallos.push(ultima);
    }

    // El orden de la lista es el de aparición en la página, no el de comprobación.
    fallos.sort((a, b) => a.getBoundingClientRect().top - b.getBoundingClientRect().top);
    return fallos;
  }

  // En cuanto se corrige, desaparece el aviso: no se espera a reenviar.
  form.addEventListener("input", (e) => {
    const el = e.target as HTMLInputElement;
    if (el.classList && el.classList.contains("campo-mal") && el.checkValidity()) limpiaError(el);
  });
  form.addEventListener("change", (e) => {
    const el = e.target as HTMLInputElement;
    if (el.classList && el.classList.contains("campo-mal") && el.checkValidity()) limpiaError(el);
  });

  // --- Envío ---
  const msg = $("#ins-msg"), submitBtn = $("#ins-submit") as HTMLButtonElement;
  form.addEventListener("submit", async (e) => {
    e.preventDefault();
    msg.textContent = ""; msg.classList.remove("ok");
    const fallos = validar();
    if (fallos.length) {
      msg.textContent = fallos.length === 1
        ? "Falta un campo por rellenar. Te lo he marcado en rojo."
        : `Faltan ${fallos.length} campos por rellenar. Te los he marcado en rojo.`;
      irA(fallos[0]);
      return;
    }

    const fd = new FormData(form as HTMLFormElement);
    const fields = Object.fromEntries(fd.entries());
    // El "titular" del registro es el integrante 1 (para poder listarlo en Airtable)
    const first = intList.querySelector(".int-card");
    const g1 = (k) => ((first.querySelector('[data-c="' + k + '"]') as HTMLInputElement).value || "").trim();
    fields.nombre = g1("nombre");
    fields.apellidos = g1("apellidos");
    fields.nacimiento = g1("nacimiento");
    fields.pais = g1("pais");
    fields.representa = g1("representa");
    fields.instagram = g1("instagram");
    // En solistas, el email de contacto es el del propio competidor
    if (max === 1) fields.email = g1("email");
    // Una por línea: los nombres de categoría ya llevan " · " dentro, así que
    // separarlas con el mismo signo las volvía ilegibles en Airtable.
    fields.otras_categorias = catsInputs.filter((c) => c.checked).map((c) => c.value).join("\n");
    fields.integrantes = buildIntegrantes();
    fields.n_integrantes = String(intList.children.length);
    fields.acepta_bases = (form.querySelector('[name="acepta_bases"]') as HTMLInputElement).checked;
    fields.acepta_rgpd = (form.querySelector('[name="acepta_rgpd"]') as HTMLInputElement).checked;
    delete fields.foto;

    submitBtn.disabled = true; submitBtn.textContent = "Enviando…";
    try {
      const r = await fetch(FN, { method: "POST", headers: { "content-type": "application/json" }, body: JSON.stringify({ action: "submit", password: pass, fields, photo, logo }) });
      const d = await r.json();
      if (r.ok && d.ok) { form.hidden = true; $("#ins-ok").hidden = false; window.scrollTo({ top: 0, behavior: "smooth" }); }
      else { msg.textContent = d.error || "No se pudo enviar. Inténtalo de nuevo."; }
    } catch { msg.textContent = "Error de conexión. Inténtalo de nuevo."; }
    finally { submitBtn.disabled = false; submitBtn.textContent = "Enviar inscripción"; }
  });

  // --- Otra inscripción ---
  $("#ins-again").addEventListener("click", () => {
    (form as HTMLFormElement).reset();
    photo = null; lastFile = null; $("#cartel").hidden = true; $("#foto-ratio").textContent = "";
    intList.innerHTML = ""; stepInt.hidden = true; stepComun.hidden = true;
    fldGrupo.hidden = true; grupoInput.required = false; $("#esp-hint").hidden = false;
    $("#ins-ok").hidden = true; form.hidden = false;
  });
</script>
