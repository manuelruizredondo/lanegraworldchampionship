---
// Atajo al panel de la organización, por si alguien tiene guardada esta URL.
// El escritorio de la cuenta (/cuenta/) hace ya lo mismo y de forma más
// completa; aquí solo se monta el panel, sin los favoritos.
import Base from "@/layouts/Base.astro";
import PanelOrganizacion from "@/components/PanelOrganizacion.astro";
import { CUENTA_I18N, PANEL_I18N } from "@/data/supabase.js";
---

<Base noindex title="Panel de la organización" description="Zona privada de la organización." lang="es">
  <div class="prop">
    <section class="p-section adm">
      <div class="p-container">
        <p class="p-eyebrow">Organización · La Negra World Championship</p>
        <h1 class="p-display adm-title">Panel de la organización</h1>

        <div id="gate" class="adm-box" hidden>
          <p id="gate-txt">Entra con tu cuenta para ver el panel.</p>
          <button type="button" class="p-btn p-btn-dark" data-cu-abrir>{CUENTA_I18N.es.entrar}</button>
          <p id="gate-msg" class="adm-msg" role="alert"></p>
        </div>
        <p id="cargando" class="adm-msg">{PANEL_I18N.es.cargando}</p>

        <PanelOrganizacion />
      </div>
    </section>
  </div>
</Base>

<script is:inline>
  (function () {
    const $ = (s) => document.querySelector(s);

    async function cargar() {
      const sb = await window.laNegraCuenta.cliente();
      const sesion = window.laNegraCuenta.sesion();
      $("#cargando").hidden = true;

      if (!sesion) {
        $("#gate").hidden = false;
        $("[data-panel-org]").hidden = true;
        return;
      }

      // ¿Tiene rol de admin? Lo dice la base, no esta página.
      const { data: perfil } = await sb.from("perfiles").select("rol").eq("id", sesion.user.id).maybeSingle();
      if (!perfil || perfil.rol !== "admin") {
        $("#gate").hidden = false;
        $("#gate-txt").textContent = "Tu cuenta (" + sesion.user.email + ") no tiene permiso para ver el panel.";
        $("#gate-msg").textContent = "Pide a la organización que te dé acceso.";
        $("[data-panel-org]").hidden = true;
        return;
      }

      $("#gate").hidden = true;
      $("[data-panel-org]").hidden = false;
      await window.laNegraPanelOrg.pintar(sb);
    }

    const esperar = setInterval(() => {
      if (!window.laNegraCuenta) return;
      clearInterval(esperar);
      window.laNegraCuenta.alCambiar(() => cargar());
      window.laNegraCuenta.cliente().then(cargar);
    }, 120);
  })();
</script>

<style>
  .adm { padding-top: 20px; }
  .adm-title { font-size: clamp(30px, 4.4vw, 52px); margin-bottom: 22px; }
  .adm-box { max-width: 460px; background: #fff; border: 1px solid #ece7dd; border-radius: 14px; padding: 22px; }
  .adm-box[hidden] { display: none; }
  .adm-box p { margin: 0 0 14px; }
  .adm-msg { margin: 10px 0 0; font-size: 13.5px; color: #8a8578; }
  .adm-msg[hidden] { display: none; }
</style>
